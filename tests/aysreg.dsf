; NextDAAD AYS register-loss fixture - every event that writes or parks
; the AY chips while a change-only AYS stream is playing.
;
; Compiled by tests\build-tests.ps1 on every run; made the active
; GAME.DDB in sd\AYSREG\ by tests\build-tests.ps1 -AysReg, which also
; stages:
;   001.AYS  tests\audio\mkays.py steady stream: nine sustained voices,
;            every register written once at frame 0, 60 s, loop at 0
;   002.AYS  tests\audio\mkays.py loop-wrap probe (states S0/S1/S2,
;            loop at frame 50)
;   GAME.SFB the kit's STARTER_FX.aks effects bank (SongToSoundEffects)
;   001.VID  the smallest cached -Vid leg encode, if one exists
; No 001.WAV is staged, deliberately: SFX 1 1 must fall back to AY
; effect 1 on PSG 3.
;
; Headless check: tests\audio\aysreg_check.py (DEBUG build, ZEsarUX).
; Voice checks by ear belong to the silicon sheet.

#define fPlayer             38
#define fDarkF              28

/CTL
_
/VOC
NORTH  2  noun
SOUTH  3  noun
LOOK   4  verb
STEADY 60 verb
WRAP   61 verb
ZAP    62 verb
BLEEP  63 verb
STOPFX 64 verb
STOPM  65 verb
MOVIE  66 verb
/STX
/0  "It's too dark to see anything."
/1  "I can also see:"
/2  "What now?"
/3  "What next?"
/4  "What should I do now?"
/5  "What should I do next?"
/6  "I didn't understand."
/7  "I can't go in that direction."
/8  "I can't do that."
/9  "I have with me:"
/10 "I am wearing:"
/11 " "
/12 "Are you sure?"
/13 "Another go?"
/14 " "
/15 "OK."
/16 "Press any key."
/17 " "
/18 " "
/19 " "
/20 " "
/21 " "
/22 " "
/23 "I'm not wearing one of those."
/24 "I can't. My hands are full."
/25 "I already have the _."
/26 "There isn't one of those here."
/27 "I can't carry any more things."
/28 "I don't have one of those."
/29 "I'm already wearing the _."
/30 "Y"
/31 "N"
/32 "More..."
/33 ">"
/34 " "
/35 " "
/36 "I now have the _."
/37 "I'm now wearing the _."
/38 "I've removed the _."
/39 "I've dropped the _."
/40 "I can't wear the _."
/41 "I can't remove the _."
/42 "I can't remove the _. My hands are full."
/43 "The _ weighs too much for me."
/44 "The _ is in the"
/45 "The _ isn't in the"
/46 ", "
/47 " and "
/48 ".#n"
/49 "I don't have the _."
/50 "I'm not wearing the _."
/51 "."
/52 "There isn't one of those in the"
/53 "Nothing."
/54 " "
/55 " "
/56 " "
/57 "I/O Error"
/58 " "
/59 "File name error."
/60 "Type in name of file."
/MTX
/0 "NEXTDAAD AYS REGISTER-LOSS FIXTURE#n"
/OTX
/0 "a brass lamp"
/LTX
/0 ""
/1 "The listening room."
/CON
/0
NORTH 1
/1
SOUTH 0
/OBJ
/0    1   1   _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _   _ _
/PRO 0
> _ _   AT 0
        PROCESS 6
> _ _   WINDOW 1
        WINAT 0 0
        WINSIZE 25 127
        CLEAR fDarkF
> _ _   WINDOW 1
        DESC @fPlayer
> _ _   PROCESS 1
/PRO 1
> _ _   PARSE 0
        REDO
> _ _   PROCESS 5
        ISDONE
        REDO
> _ _   MOVE fPlayer
        CLS
        RESTART
> _ _   SYSMESS 8
        REDO
/PRO 5
> STEADY _ MES "001.AYS steady chord, looped - SFX 1 7#n"
           SFX 1 7
           DONE
> WRAP   _ MES "002.AYS loop-wrap probe, looped - SFX 2 7#n"
           SFX 2 7
           DONE
> ZAP    _ MES "AY effect 1 on PSG 3 - SFX 1 1#n"
           SFX 1 1
           DONE
> BLEEP  _ MES "beep on PSG 3 - BEEP 100 120#n"
           BEEP 100 120
           DONE
> STOPFX _ MES "effect stop, nothing playing - SFX 0 5#n"
           SFX 0 5
           DONE
> STOPM  _ MES "music stopped - SFX 0 8#n"
           SFX 0 8
           DONE
> MOVIE  _ MES "001.VID once - SFX 1 9#n"
           SFX 1 9
           DONE
/PRO 6
> _ _   WINDOW 1
        WINAT 0 0
        WINSIZE 25 127
        PAPER 0
        INK 7
        CLS
        MESSAGE 0
> _ _   MES "STEADY  001.AYS, nine held notes#n"
        MES "WRAP    002.AYS, loop-wrap probe#n"
        MES "ZAP     AY effect 1#n"
        MES "BLEEP   beep#n"
        MES "STOPFX  effect stop#n"
        MES "STOPM   stop music#n"
        MES "MOVIE   play 001.VID#n"
        GOTO 1
/END
