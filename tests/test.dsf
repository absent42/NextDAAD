/OBJ    ;Object Definitions
;obj  starts  weight    c w  5 4 3 2 1 0 9 8 7 6 5 4 3 2 1 0    noun   adjective
;num    at
/0      CARRIED 1       _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _    TORCH  _


;------------------------------------------------------------------------------
/PRO 0       ;Main Location Loop


; This process is the first one executed by DAAD, and so it contains a first entry that
; jumps to the process that initializes objects, flags, etc. and then every time it is called, and the
; player is not in location 0, it takes care of showing the graphic and text of the current location,
; if any, and jumps to process 1 where the system that asks for player commands 



> _       _     AT      0               ; Starting game?
                PROCESS 6               ; Initialise
                

> _       _     WINAT 13 0              ; by default, we have a text window at the bottom of the screen
                #ifdef "splitModeOn"    ; if split mode is on, we have to apply it
                    XSPLITSCR 1
                    #ifdef "cpc"
                    WINAT 14 0           ;  if it's CPC, we have to move the window down a bit to avoid screen glitches
                    #endif
                #endif
                WINDOW 1
                WINSIZE 25 127


> _       _     WINDOW  0               ; Graphic window
                CLEAR   fDarkF          ; Assume it is light
                NOTZERO 0
                ABSENT  0
                SET     fDarkF          ; Dark
                

                
> _       _     ZERO fDarkF
                PICTURE @fPlayer        ; if there is a picture, load it
                DISPLAY 0
                SKIP $pictureOK


; if we got here, there is no picture, so we have to set the text window full screen
> _       _     #ifdef "splitModeOn"                  
                    CLS                     ; If it was split mode, we have to clear the screen
                    XSPLITSCR 0             ; and disable split mode
                #endif
                WINDOW 1
                WINAT 0 0               ; Full screen text window
                WINSIZE 25 127
                CLS
$pictureOK

> _       _     WINDOW 1                 ; text window
                NOTZERO fDarkF           ; dark
                SYSMESS 0

> _       _     ZERO    fDarkF
                DESC   @fPlayer        

; Now call process 3 for events that can be added to the current location description or happen when entering a location.

> _       _     PROCESS 3


; and now we can start the main loop of the game, which is process 1.

> _       _     PROCESS 1


;------------------------------------------------------------------------------
/PRO 1
> _       _     PROCESS 4               ; Do process 2 stuff here


> _       _     PARSE   0               ; Get next LS from current buffer
                PROCESS 2               ; Failed cos of invalid or timeout
                REDO

> _       _     EQ      fTurns   255     ; Max for one byte
                PLUS    fTurnsHi 1
                CLEAR   fTurns
                SKIP    1

> _       _     PLUS    fTurns   1

> _       _     PROCESS 5               ; Do any commands
                ISDONE                  ; Done something
                REDO

> _       _     MOVE    fPlayer          ; No so try to move player
                CLS
                RESTART                 ; Absolute jump to start process 0

> _       _     NEWTEXT
                LT      fVerb    14
                SYSMESS 7
                REDO

> _       _     SYSMESS 8
                REDO


;------------------------------------------------------------------------------
/PRO 2
> _       _     HASAT TIMEOUT
                SYSMESS 35
                DONE

> _       _     SYSMESS 6               ; I didn't understand

;------------------------------------------------------------------------------
/PRO 3 ; Old process 1. Note that both the response table and the old PAW 
; process tables 1 and 2 can now be anywhere or completely absent. Everything
; is implemented in the DAAD language itself.

; Border cycles with the location (BORDER = location AND 7): a walk
; around the map visibly steps the surround colour on real hardware.
; CSpect does not render the fallback colour (see the hardware test
; checklist), so no change is expected in the emulator.
> _       _     BORDER @fPlayer

;This is better carried out thus
> _       _     NEWLINE
                ZERO    fDarkF            ; Isn't dark
                LISTOBJ

;than the old system needed in Version 1, without accesss to DarkF
