/PRO 6 ; Initialisation

> _       _     
                WINDOW  0                  ; Make window 0 be full screen, and clear it
                WINAT 0 0
                WINSIZE 25 128
                BORDER 1                   ; blue surround: one-look NR $4A fallback check
                CLS
                WINDOW  1                  ; Define text Window starting at line 14
                WINAT 14 0
                WINSIZE 25 128             ; Also maximum with and height
                WINDOW 0
                PICTURE 0 
                DISPLAY 0
                SKIP $picture0OK


>  _     _      WINDOW  1                       ; if we get here, there is no picture for location 0, so we have to set the text window full screen
                WINAT 0 0              
                WINSIZE 25 128                  
                #ifdef "splitModeOn"            ; Disable split mode if so
                    XSPLITSCR 0
                    PAUSE 10
                #endif

$picture0OK
> _       _     WINDOW 1
                DESC    0               ; Intro text
                ANYKEY
                CLS
                SET   255             

$initLoop                
> _       _     MINUS   255 1          ; Clear all flags
                NOTEQ   255  fGFlags  ; but GFlags!!!
                CLEAR   @255

> _       _     NOTZERO 255             
                SKIP    $initLoop

> _       _     RESET                     ; Objects to initial locations / Flag 1
                LET     fStrength 10
                LET     fMaxCarr 4
                SET     fCPronounNoun
                SET     fCPronounAdject
                LET     fObjectsCarried   NUM_CARRIED
                GOTO    1                 ; Go to first location
;------------------------------------------------------------------------------
/PRO 7 ; MTEST polling loop (SP11 rework). Called once per MTEST command
; via PRO 5's `PROCESS 7`; MOUSE 0 1 (pattern upload/show) stays in PRO 5
; and is NOT repeated here - only the poll/print/exit-check loops.
;
; Loop mechanism: REDO (condact 108, action, argc 0; see h_redo in
; src/overlay0.asm) restarts THIS table from its own first entry - it
; reads the process number of whichever frame is on top of the process
; stack when REDO runs, which is PRO 7's own frame while we are inside
; it (called via PROCESS, not yet returned). So REDO here provably loops
; PRO 7 in place; it cannot fall back into PRO 5 and cannot re-trigger
; MOUSE 0 1.
;
; Entry 1 (poll + display): MOUSE 120 3 (action, argc 2) polls the
; hardware into flags 120-123 and repositions the sprite. SAVEAT/BACKAT
; (condacts 97/98, actions, argc 0) bracket the four PRINTs so every
; pass overwrites the same screen spot instead of scrolling. INKEY
; (condact 111, CONDITION, argc 0) is true the instant a key is waiting
; (its code is left in flag 60); on true the entry falls through to
; NEWLINE (drop below the live line) then MOUSE 0 2 (hide pointer) then
; DONE, which unwinds PROCESS 7 and lets MTEST's own DONE follow. On
; false, INKEY's failure ABORTS this entry (DAAD's normal
; condition-fail-continues-to-next-entry rule) and the table scan moves
; to entry 2.
;
; Entry 2 (re-poll trigger): reached only on entry 1's false INKEY.
; PAUSE 1 (action, argc 1) paces the loop to one frame (1/50s) so it
; does not spin hot against the hardware poll; REDO then restarts entry
; 1 for the next poll. This table has no other entries and is only ever
; reached via MTEST's PROCESS 7, so it can never act as a stray
; catch-all for other verbs.
> _       _     MOUSE 120 3
                SAVEAT
                MES "mouse btn:"
                PRINT 120
                SPACE
                MES "col80:"
                PRINT 121
                SPACE
                MES "row32:"
                PRINT 122
                SPACE
                MES "col53:"
                PRINT 123
                BACKAT
                INKEY
                NEWLINE
                MOUSE 0 2
                DONE

> _       _     PAUSE 1
                REDO
;------------------------------------------------------------------------------
/PRO 8 ; MTEST submission-key drain (SP11 hardware-run fix #2). Called
; once per MTEST invocation by PRO 5's `PROCESS 8`, BEFORE `PROCESS 7`
; starts the actual poll loop. Purpose: drain the ENTER keypress that
; just submitted the "mtest" command line, which is very often still
; physically down (or not yet reported released by the hardware) the
; instant control reaches here - if PRO 7's own exit check saw that
; stale press, the loop would end after a single pass, which is exactly
; the symptom the owner's first hardware run reported.
;
; h_inkey (condact 111, CONDITION, argc 0; src/overlay0.asm) SENSES the
; live keyboard matrix on every call via key_scan (a plain port read/
; decode with no latch, buffer, or "already reported" flag) - it does
; not consume a press. So this table simply spins for as long as ANY
; key currently reads as down, and stops the instant the hardware
; genuinely reports none held - correct whether it is the stale ENTER
; from submission or (much less likely, but harmless the same way) some
; other key still being released by the owner's hand.
> _       _     INKEY
                REDO
;
; REDO (condact 108, action, argc 0; h_redo, src/overlay0.asm) restarts
; "the top of the process stack"'s own table from ITS OWN first entry.
; While this single-entry table is running (pushed by PRO 5's
; `PROCESS 8`, not yet returned), PRO 8's frame IS the top of the
; stack, so REDO here can only ever restart PRO 8's own one entry - it
; cannot fall back into PRO 5 and cannot reach PRO 7. Once INKEY
; finally reads false (every key genuinely released), this entry
; ABORTS (DAAD's normal condition-fail-continues-to-next-entry rule);
; there is no next entry in this table, so the scan hits the table end
; and control returns to PRO 5's calling entry, right after
; `PROCESS 8` - i.e. MTEST's own `PROCESS 7`, which starts the real,
; exitable poll loop against a confirmed-clear keyboard.
;
; PRO 8 is deliberately a SEPARATE table from PRO 7, not a first entry
; folded into PRO 7 itself (the shape first proposed for this fix).
; REDO always resets to a table's OWN first entry (see above) - so had
; the drain been PRO 7's entry 1, PRO 7's existing PAUSE/REDO tail
; (which must equally REDO back to PRO 7's own first entry, by the same
; rule) would revisit the drain entry on EVERY poll pass, not just the
; first one. `eng_step`/`eng_exec` (src/engine.asm) dispatch one
; condact per engine step and advance to the next entry the instant a
; condition fails, with no real time elapsing in between (no interrupt
; wait, no PAUSE) - so on every single poll cycle, a same-table drain
; entry would run its own INKEY microseconds before the poll entry got
; its turn, and would therefore win the race for any genuinely held key
; essentially every time (the key is already "down" at the earlier
; check, long before the later, real exit check ever sees it as fresh).
; That silently swallows every real owner keypress into an endless
; freeze/resume cycle that never actually exits - worse than the bug
; being fixed. Splitting the one-shot drain into its own table (PRO 8)
; sidesteps this entirely: PRO 7's own two entries (poll+exit-check,
; then pause+redo) are exactly as they were before this addendum and
; are never revisited by the drain once it has finished.
;------------------------------------------------------------------------------
/PRO 9 ; KTEST polling loop (silicon keyboard-defect task). Called once
; per KTEST invocation via PRO 5's `PROCESS 9`. Same REDO-restarts-
; this-table-only reasoning as PRO 7/PRO 8 above (h_redo restarts the
; top of the process stack's own table; while this frame is live via
; PROCESS, not yet returned, that is always THIS table's own first
; entry - it cannot fall back into PRO 5).
;
; Entry 1 (poll + draw + exit-check): EXTERN 0 6 (action, argc 2)
; dispatches to ktest_poll (overlay1.asm) via extVec vector 6
; (overlay0.asm's ktest_trampoline) - DEBUG-only; Release's vector 6 is
; ext_stub, a silent no-op, so this verb just leaves a blank diagnostic
; area in a Release build rather than crashing. ktest_poll draws the
; whole diagnostic screen itself (native dbg_* console calls - DAAD's
; own PRINT is decimal-only and cannot show binary/hex/glyphs) and
; sets flags+130 to 1 exactly when TRUE VIDEO (CAPS+3) is currently
; held. NOTZERO 130 (CONDITION, argc 0) passes when that flag is set,
; falling through to DONE, which unwinds PROCESS 9 and lets KTEST's
; own CLS/DONE (PRO 5) follow. On flags+130 == 0, NOTZERO's failure
; ABORTS this entry (DAAD's normal condition-fail-continues-to-next-
; entry rule) and the table scan moves to entry 2.
;
; Entry 2 (re-poll trigger): reached only on entry 1's false NOTZERO.
; PAUSE 1 paces the loop to one frame so it does not spin hot against
; the hardware poll; REDO then restarts entry 1 for the next poll/draw
; pass.
> _       _     EXTERN 0 6
                NOTZERO 130
                DONE

> _       _     PAUSE 1
                REDO

/PRO 10 ; Post-video location art redraw. Called by every video verb
; (VPLY0-4/VLOP0-4/SPLY4, PRO 5) after playback returns. The NXV player
; deliberately leaves the L2 surface as the video left it (spec: the
; game redraws after a cutscene; auto snapshot/restore is an SP15+
; nicety) - this table models the documented author convention with the
; same PICTURE/DISPLAY pair the main location loop uses (PRO 0). Entry
; 1: PICTURE failure (no art for this location) aborts the entry per
; DAAD's condition-fail rule and falls to entry 2's bare DONE, so
; art-less locations exit cleanly with the surface as the player left
; it (cleared).
> _       _     PICTURE @fPlayer
                DISPLAY 0
                DONE

> _       _     DONE
/END