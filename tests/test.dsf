;------------------------------------------------------------------------------
/OBJ    ;Object Definitions
;obj  starts  weight    c w  5 4 3 2 1 0 9 8 7 6 5 4 3 2 1 0    noun   adjective
;num    at
/0      CARRIED 1       _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _    TORCH  _


;------------------------------------------------------------------------------
/PRO 0       ;Main Location Loop


; This process is the first one executed by DAAD, and so it contains a first entry that
; jumps to the process that initializes objects, flags, etc. and then every time it is called, and the
; player is not in location 0, it takes care of showing the graphic and text of the current location,
; if any, and jumps to process 1 where the system that asks for player commands 



> _       _     AT      0               ; Starting game?
                PROCESS 6               ; Initialise
                

> _       _     WINAT 13 0              ; by default, we have a text window at the bottom of the screen
                #ifdef "splitModeOn"    ; if split mode is on, we have to apply it
                    XSPLITSCR 1
                    #ifdef "cpc"
                    WINAT 14 0           ;  if it's CPC, we have to move the window down a bit to avoid screen glitches
                    #endif
                #endif
                WINDOW 1
                WINSIZE 25 127


> _       _     WINDOW  0               ; Graphic window
                CLEAR   fDarkF          ; Assume it is light
                NOTZERO 0
                ABSENT  0
                SET     fDarkF          ; Dark
                

                
> _       _     ZERO fDarkF
                PICTURE @fPlayer        ; if there is a picture, load it
                DISPLAY 0
                SKIP $pictureOK


; if we got here, there is no picture, so we have to set the text window full screen
> _       _     #ifdef "splitModeOn"                  
                    CLS                     ; If it was split mode, we have to clear the screen
                    XSPLITSCR 0             ; and disable split mode
                #endif
                WINDOW 1
                WINAT 0 0               ; Full screen text window
                WINSIZE 25 127
                CLS
$pictureOK

> _       _     WINDOW 1                 ; text window
                NOTZERO fDarkF           ; dark
                SYSMESS 0

> _       _     ZERO    fDarkF
                DESC   @fPlayer        

; Now call process 3 for events that can be added to the current location description or happen when entering a location.

> _       _     PROCESS 3


; and now we can start the main loop of the game, which is process 1.

> _       _     PROCESS 1


;------------------------------------------------------------------------------
/PRO 1
> _       _     PROCESS 4               ; Do process 2 stuff here


> _       _     PARSE   0               ; Get next LS from current buffer
                PROCESS 2               ; Failed cos of invalid or timeout
                REDO

> _       _     EQ      fTurns   255     ; Max for one byte
                PLUS    fTurnsHi 1
                CLEAR   fTurns
                SKIP    1

> _       _     PLUS    fTurns   1

> _       _     PROCESS 5               ; Do any commands
                ISDONE                  ; Done something
                REDO

> _       _     MOVE    fPlayer          ; No so try to move player
                CLS
                RESTART                 ; Absolute jump to start process 0

> _       _     NEWTEXT
                LT      fVerb    14
                SYSMESS 7
                REDO

> _       _     SYSMESS 8
                REDO


;------------------------------------------------------------------------------
/PRO 2
> _       _     HASAT TIMEOUT
                SYSMESS 35
                DONE

> _       _     SYSMESS 6               ; I didn't understand

;------------------------------------------------------------------------------
/PRO 3 ; Old process 1. Note that both the response table and the old PAW 
; process tables 1 and 2 can now be anywhere or completely absent. Everything
; is implemented in the DAAD language itself.

; Border cycles with the location (BORDER = location AND 7): a walk
; around the map visibly steps the surround colour on real hardware.
; CSpect does not render the fallback colour (see the hardware test
; checklist), so no change is expected in the emulator.
> _       _     BORDER @fPlayer

;This is better carried out thus
> _       _     NEWLINE
                ZERO    fDarkF            ; Isn't dark
                LISTOBJ

;than the old system needed in Version 1, without accesss to DarkF
;> _       _     NEWLINE
;                ZERO    0               ;If it is light...
;                ABSENT  0               ;and the light source is absent...
;                LISTOBJ                 ;List the objects

;> _       _     PRESENT 0               ;If the light source is present...
;                LISTOBJ                 ;List the objects

;------------------------------------------------------------------------------
/PRO 4 ; Old process 2
;------------------------------------------------------------------------------
/PRO 5 ; Command decoder

> I       _     SYSMESS 9
                LISTAT  CARRIED
                SYSMESS 10
                LISTAT  WORN
                DONE

> GET     ALL   DOALL   HERE
> GET     _     AUTOG
                DONE

> DROP    ALL   DOALL   CARRIED
> DROP    _     AUTOD
                DONE

> REMOVE  ALL   DOALL   WORN
> REMOVE  _     AUTOR
                DONE

> WEAR    ALL   DOALL   CARRIED
> WEAR    _     AUTOW
                DONE

> R       _     CLS
                RESTART

> Q       _     QUIT
                END

> Q       _     DONE                    ;Not like QUIT on PAW

> SAVE    _     SAVE 0
                CLS
                RESTART

> LOAD    _     LOAD   0
                CLS
                RESTART

> RAMSA   _     RAMSAVE
                CLS
                RESTART

> RAMLO   _     RAMLOAD 255             ;Reload all flags
                CLS
                RESTART

> LOOK    _     CLS
                RESTART

; Audio owner verbs (SP7): ear checks against the -Aud staged assets
; (001.AKY, GAME.SFB). TUNE plays once and ends in silence; MUSIC
; loops until STOPM.
> SOUND   _     SFX 1 1
                DONE

> MUSIC   _     SFX 1 7
                DONE

> TUNE    _     SFX 1 6
                DONE

> STOPM   _     SFX 0 8
                DONE

; SP8 sample verbs: 001.WAV via -Aud staging. SAMP once, SAMPL loop,
; SAMPR sub-3 (plays as SAMP), SSTOP stops sample and AY effect.
; AYFX: no 002.WAV exists, so effect 2 falls through to the AY bank -
; NOTE the old SOUND verb (SFX 1 1) now resolves to the SAMPLE once
; 001.WAV is staged.
> SAMP    _     SFX 1 1
                DONE

> SAMPL   _     SFX 1 2
                DONE

> SAMPR   _     SFX 1 3
                DONE

> SSTOP   _     SFX 0 5
                DONE

> AYFX    _     SFX 2 1
                DONE

; SP9 owner verbs: XMES is the eye verb for EXTERN vector 3
; (XMESSAGE) - also proves the template 0.XMB emission/staging wired
; in Task 3. AYBAD is the ear verb for the SFB bounds guard (Task 4):
; GAME.SFB has 6 effects and no 200.WAV exists, so effect 200 must be
; pure silence, never garbage tones.
> XMES    _     XMESSAGE "External message via 0.XMB - tokens, wrap and More paging all native."
                DONE

> AYBAD   _     SFX 200 1
                DONE

; SP10 owner verb: TUNE2 is the ear leg for the AYS streamed song - the
; too-big-for-AKY 002.AYS (via -Aud staging). SFX 2 7 loops the stream;
; STOPM (SFX 0 8) stops it (sub 8 now stops both music kinds).
> TUNE2   _     SFX 2 7
                DONE

; SP10 Task 5 owner verb, reworked SP11: MTEST is the eye/hardware leg
; for the Kempston mouse condact. MOUSE 0 1 uploads the arrow pattern
; (first call only, gated internally by mouseReady), arms NR $15 and
; shows/positions hardware sprite 0 - once, here, on entry. The verb
; then hands off to PRO 7, which LOOPS: poll (MOUSE 120 3) into scratch
; flags 120-123 (buttons, X/8, Y/8, X/6), reprint them in place on the
; same screen spot, repeat - so the owner watches the values track live
; mouse movement instead of seeing one static snapshot. Any keypress
; (INKEY, in PRO 7) ends the loop; the pointer is hidden (MOUSE 0 2)
; before the verb returns DONE. Under headless CSpect (no -mouse
; capture, or CSpect closed) the sprite still shows/positions and the
; flags still print - just static/zero without a live pointer - and a
; keypress still exits normally.
> MTEST   _     MOUSE 0 1
                PROCESS 7
                DONE
;------------------------------------------------------------------------------
/PRO 6 ; Initialisation

> _       _     
                WINDOW  0                  ; Make window 0 be full screen, and clear it
                WINAT 0 0
                WINSIZE 25 128
                BORDER 1                   ; blue surround: one-look NR $4A fallback check
                CLS
                WINDOW  1                  ; Define text Window starting at line 14
                WINAT 14 0
                WINSIZE 25 128             ; Also maximum with and height
                WINDOW 0
                PICTURE 0 
                DISPLAY 0
                SKIP $picture0OK


>  _     _      WINDOW  1                       ; if we get here, there is no picture for location 0, so we have to set the text window full screen
                WINAT 0 0              
                WINSIZE 25 128                  
                #ifdef "splitModeOn"            ; Disable split mode if so
                    XSPLITSCR 0
                    PAUSE 10
                #endif

$picture0OK
> _       _     WINDOW 1
                DESC    0               ; Intro text
                ANYKEY
                CLS
                SET   255             

$initLoop                
> _       _     MINUS   255 1          ; Clear all flags
                NOTEQ   255  fGFlags  ; but GFlags!!!
                CLEAR   @255

> _       _     NOTZERO 255             
                SKIP    $initLoop

> _       _     RESET                     ; Objects to initial locations / Flag 1
                LET     fStrength 10
                LET     fMaxCarr 4
                SET     fCPronounNoun
                SET     fCPronounAdject
                LET     fObjectsCarried   NUM_CARRIED
                GOTO    1                 ; Go to first location
;------------------------------------------------------------------------------
/PRO 7 ; MTEST polling loop (SP11 rework). Called once per MTEST command
; via PRO 5's `PROCESS 7`; MOUSE 0 1 (pattern upload/show) stays in PRO 5
; and is NOT repeated here - only the poll/print/exit-check loops.
;
; Loop mechanism: REDO (condact 108, action, argc 0; see h_redo in
; src/overlay0.asm) restarts THIS table from its own first entry - it
; reads the process number of whichever frame is on top of the process
; stack when REDO runs, which is PRO 7's own frame while we are inside
; it (called via PROCESS, not yet returned). So REDO here provably loops
; PRO 7 in place; it cannot fall back into PRO 5 and cannot re-trigger
; MOUSE 0 1.
;
; Entry 1 (poll + display): MOUSE 120 3 (action, argc 2) polls the
; hardware into flags 120-123 and repositions the sprite. SAVEAT/BACKAT
; (condacts 97/98, actions, argc 0) bracket the four PRINTs so every
; pass overwrites the same screen spot instead of scrolling. INKEY
; (condact 111, CONDITION, argc 0) is true the instant a key is waiting
; (its code is left in flag 60); on true the entry falls through to
; NEWLINE (drop below the live line) then MOUSE 0 2 (hide pointer) then
; DONE, which unwinds PROCESS 7 and lets MTEST's own DONE follow. On
; false, INKEY's failure ABORTS this entry (DAAD's normal
; condition-fail-continues-to-next-entry rule) and the table scan moves
; to entry 2.
;
; Entry 2 (re-poll trigger): reached only on entry 1's false INKEY.
; PAUSE 1 (action, argc 1) paces the loop to one frame (1/50s) so it
; does not spin hot against the hardware poll; REDO then restarts entry
; 1 for the next poll. This table has no other entries and is only ever
; reached via MTEST's PROCESS 7, so it can never act as a stray
; catch-all for other verbs.
> _       _     MOUSE 120 3
                SAVEAT
                MES "mouse btn:"
                PRINT 120
                SPACE
                MES "col80:"
                PRINT 121
                SPACE
                MES "row32:"
                PRINT 122
                SPACE
                MES "col53:"
                PRINT 123
                BACKAT
                INKEY
                NEWLINE
                MOUSE 0 2
                DONE

> _       _     PAUSE 1
                REDO
/END