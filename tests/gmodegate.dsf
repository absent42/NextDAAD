; NextDAAD SP16 Task 1 fixture - the GMODE graphics gate.
;
; Compiled by tests\build-tests.ps1 on every run; staged as the active
; GAME.DDB in sd\GMODE\ by tests\build-tests.ps1 -GMode, which also
; stages the one Layer 2 picture it needs as 001.NX2 in that same
; folder. Owner leg instructions are in the SP16 Task 1 report (DEBUG
; build, real hardware).
;
; WHAT IT PINS
; DAAD flag 29 (fGFlags) is the capability byte a period game tests
; before it draws anything: bit 7 "graphics available", read as
; HASAT GMODE (attribute 247 -> flags[59 - 247/8] = flag 29, bit
; 247 mod 8 = 7), and bit 0 "mouse present" (HASAT MOUSE, 240 ->
; flag 29 bit 0). NextDAAD never wrote flag 29 at all, so HASAT
; GMODE was FALSE and every game built around that gate ran here as
; if it were on a text-only machine - no location art whatsoever, on
; an interpreter whose whole purpose is Layer 2 location art.
; See docs\daad-compliance-report.md section 4 (C1, C2) and
; docs\parser-bugs.md entry 6. SP16 Task 1 publishes flag 29 = 129
; (bit 7 Layer 2 + bit 0 MOUSE implemented) and flag 62 = 144 at
; eng_init_game.
;
; The main location loop is the DAAD BLANK template's own loop with
; ONE change: the picture entry is gated on HASAT GMODE, which is how
; a cross-platform period game chooses between the graphic and the
; text-only fallback. With the gate closed the fixture takes the
; full-screen-text branch and prints that it did; with the gate open
; the picture loads and the text window sits under it.
;
; Window layout follows tools\Rabenstein-master\nextdaad\rabenstein
; .dsf (status WINAT 12 0 / WINSIZE 1 80, text WINAT 13 0 / WINSIZE
; 25 127) - the proven NextDAAD layout of a real graphical game,
; rather than an invented one.

; System flags used by name (DAAD BLANK template spellings)
#define fGFlags             29
#define fPlayer             38
#define fDarkF              28
#define fScreenMode         62

; Attribute numbers for HASAT/HASNAT (DAAD BLANK template, SYMBOLS)
#define GMODE     247           ; Graphics available   -> flag 29 bit 7
#define MOUSE     240           ; Mouse present        -> flag 29 bit 0

/CTL
_
/VOC
NORTH  2  noun
SOUTH  3  noun
LOOK   4  verb
/STX
/0  "It's too dark to see anything."
/1  "I can also see:"
/2  "What now?"
/3  "What next?"
/4  "What should I do now?"
/5  "What should I do next?"
/6  "I didn't understand."
/7  "I can't go in that direction."
/8  "I can't do that."
/9  "I have with me:"
/10 "I am wearing:"
/11 " "
/12 "Are you sure?"
/13 "Another go?"
/14 " "
/15 "OK."
/16 "Press any key."
/17 " "
/18 " "
/19 " "
/20 " "
/21 " "
/22 " "
/23 "I'm not wearing one of those."
/24 "I can't. My hands are full."
/25 "I already have the _."
/26 "There isn't one of those here."
/27 "I can't carry any more things."
/28 "I don't have one of those."
/29 "I'm already wearing the _."
/30 "Y"
/31 "N"
/32 "More..."
/33 ">"
/34 " "
/35 " "
/36 "I now have the _."
/37 "I'm now wearing the _."
/38 "I've removed the _."
/39 "I've dropped the _."
/40 "I can't wear the _."
/41 "I can't remove the _."
/42 "I can't remove the _. My hands are full."
/43 "The _ weighs too much for me."
/44 "The _ is in the"
/45 "The _ isn't in the"
/46 ", "
/47 " and "
/48 ".#n"
/49 "I don't have the _."
/50 "I'm not wearing the _."
/51 "."
/52 "There isn't one of those in the"
/53 "Nothing."
/54 " "
/55 " "
/56 " "
/57 "I/O Error"
/58 " "
/59 "File name error."
/60 "Type in name of file."
/MTX
/0 "NEXTDAAD GMODE GATE FIXTURE#n"
/OTX
/0 "a brass lamp"
/LTX
/0 ""
/1 "The gallery. A picture hangs here, or does not, according to what HASAT GMODE just answered."
/CON
/0
NORTH 1
/1
SOUTH 0
/OBJ
/0    1   1   _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _   _ _
/PRO 0
; ---- main location loop, template-shaped, with the GMODE gate ----
> _ _   AT 0                    ; starting the game?
        PROCESS 6               ; one-shot init + the diagnostic block
> _ _   WINDOW 1                ; text window under the picture
        WINAT 13 0
        WINSIZE 25 127
        CLEAR fDarkF
; THE GATE. A period game asks the interpreter whether it has
; graphics at all before it spends a disc access on a picture. If
; flag 29 bit 7 is clear this entry aborts at HASAT and the
; text-only entry below runs instead.
> _ _   HASAT GMODE
        PICTURE @fPlayer
        DISPLAY 0
        MES "[gate open: picture drawn]#n"
        SKIP 1
; Text-only fallback: no graphics (or the picture would not load) -
; give the text the whole screen, exactly as the BLANK template does.
> _ _   WINDOW 1
        WINAT 0 0
        WINSIZE 25 127
        CLS
        MES "[gate closed or picture missing: text-only fallback]#n"
> _ _   WINDOW 1
        DESC @fPlayer
> _ _   PROCESS 1
/PRO 1
; ---- parser loop (template shape, trimmed) ----
> _ _   PARSE 0
        REDO
> _ _   MOVE fPlayer
        CLS
        RESTART
> _ _   NEWTEXT
        LT 33 14
        SYSMESS 7
        REDO
> _ _   SYSMESS 8
        REDO
/PRO 6
; ---- one-shot init + the flag 29 / flag 62 diagnostic block ----
> _ _   WINDOW 2                ; status line, Rabenstein's layout
        WINAT 12 0
        WINSIZE 1 80
> _ _   WINDOW 1
        WINAT 0 0
        WINSIZE 25 127
        PAPER 0
        INK 7
        CLS
        MESSAGE 0
; G1 flag 29 is published at all, and with the ruled value.
> _ _   EQ fGFlags 129
        MES "G1 OK   flag 29 = 129 (bit 7 graphics, bit 0 mouse)#n"
        SKIP 1
> _ _   MES "G1 FAIL flag 29 = "
        PRINT fGFlags
        MES " (expected 129)#n"
; G2 the canonical test named in the DAAD manual and in msx2daad's
; own header comment for fGFlags: "This is best tested using
; HASAT GMODE".
> _ _   HASAT GMODE
        MES "G2 OK   HASAT GMODE true  - graphics gate OPEN#n"
        SKIP 1
> _ _   MES "G2 FAIL HASAT GMODE false - graphics gate CLOSED#n"
; G3 the other bit of the same byte. NextDAAD implements MOUSE
; (condact 66), so this must be true too.
> _ _   HASAT MOUSE
        MES "G3 OK   HASAT MOUSE true#n"
        SKIP 1
> _ _   MES "G3 FAIL HASAT MOUSE false#n"
; G4 flag 62 (fScMode): bit 7 palette switching, bit 4 native machine
; mode (msx2daad's 16|SCREEN convention), bits 0-3 the mode number -
; 144 = 128 + 16 + 0, Layer 2 256x192 256-colour.
> _ _   EQ fScreenMode 144
        MES "G4 OK   flag 62 = 144#n"
        SKIP 1
> _ _   MES "G4 FAIL flag 62 = "
        PRINT fScreenMode
        MES " (expected 144)#n"
; G5 negative control: attribute 246 is GA_MDRW (flag 29 bit 6,
; drawstring invisible-draw), which this interpreter does NOT have.
; HASNAT must be true, proving G2/G3 are reading real bits and not
; a byte that happens to be all-ones.
> _ _   HASNAT 246
        MES "G5 OK   HASNAT GA_MDRW true (bit 6 clear, as it should be)#n"
        SKIP 1
> _ _   MES "G5 FAIL flag 29 bit 6 set - value is not capability-derived#n"
> _ _   MES "#nPress a key, then watch for the picture.#n"
        ANYKEY
        CLS
        GOTO 1
/END
