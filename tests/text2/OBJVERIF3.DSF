;------------------------------------------------------------------------------
/OTX
/0 "a lamp"
/1 "the key"
/2 "some coins"
/3 "a map of the winding river valley"
/4 "a scroll sealed by the old king"
/5 "a woollen cloak with a frayed hem"
/6 "a silver ring from the old king"
/7 "a lamp"


;------------------------------------------------------------------------------
/LTX
/0 "Boot."
/1 "A long white corridor of the winding river valley. Exits north and south."
/2 "A long white corridor of the winding river valley. Exits north and south."


;------------------------------------------------------------------------------
/CON
/0
/1
N 2
/2
S 1


;------------------------------------------------------------------------------
/OBJ
;obj  starts  weight    c w  5 4 3 2 1 0 9 8 7 6 5 4 3 2 1 0    noun   adjective
/0      CARRIED 1       _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _    LAMP   _
/1      CARRIED 1       _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _    KEY    _
/2      CARRIED 1       _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _    COINS  _
/3      CARRIED 1       _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _    MAP    _
/4      CARRIED 1       _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _    SCROL  _
/5      WORN    1       _ Y  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _    CLOAK  _
/6      WORN    1       _ Y  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _    RING   _
/7      CARRIED 1       _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _    LANTE  _


;------------------------------------------------------------------------------
/PRO 0

> _       _     AT      0
                PROCESS 6

> _       _     WINDOW  0
                CLEAR   fDarkF

> _       _     WINDOW  1
                NOTZERO fDarkF
                SYSMESS 0

> _       _     ZERO    fDarkF
                DESC    @fPlayer

> _       _     PROCESS 3

> _       _     PROCESS 1

;------------------------------------------------------------------------------
/PRO 1
> _       _     PROCESS 4

> _       _     PARSE   0
                PROCESS 2
                REDO

> _       _     EQ      fTurns   255
                PLUS    fTurnsHi 1
                CLEAR   fTurns
                SKIP    $noCarry

> _       _     PLUS    fTurns   1
$noCarry
> _       _     PROCESS 5
                ISDONE
                REDO

> _       _     MOVE    fPlayer
                RESTART

> _       _     NEWTEXT
                LT      fVerb    14
                SYSMESS 7
                REDO

> _       _     SYSMESS 8
                REDO


;------------------------------------------------------------------------------
/PRO 2
> _       _     HASAT TIMEOUT
                SYSMESS 35
                DONE

> _       _     SYSMESS 6

;------------------------------------------------------------------------------
/PRO 3
> _       _     NEWLINE
                MES     27
                PRINT   fPlayer
                NEWLINE

> _       _     NEWLINE
                ZERO    fDarkF
                LISTOBJ

;------------------------------------------------------------------------------
/PRO 4
;------------------------------------------------------------------------------
/PRO 5

> I       _     SYSMESS 9
                LISTAT  CARRIED
                SYSMESS 10
                LISTAT  WORN
                DONE

> GET     _     AUTOG
                DONE

> DROP    _     AUTOD
                DONE

> REMOV   _     AUTOR
                DONE

> WEAR    _     AUTOW
                DONE

> LOOK    _     RESTART

> EXAMI   LAMP  WHATO
                MESSAGE 2
                MESSAGE 4
                DONE

> EXAMI   KEY   WHATO
                MESSAGE 2
                MESSAGE 5
                DONE

> EXAMI   COINS WHATO
                MESSAGE 2
                MESSAGE 6
                DONE

> EXAMI   MAP   WHATO
                MESSAGE 2
                MESSAGE 7
                DONE

> EXAMI   SCROL WHATO
                MESSAGE 2
                MESSAGE 8
                DONE

> EXAMI   CLOAK WHATO
                MESSAGE 2
                MESSAGE 9
                DONE

> EXAMI   RING  WHATO
                MESSAGE 2
                MESSAGE 10
                DONE

> EXAMI   LANTE WHATO
                MESSAGE 2
                MESSAGE 3
                MESSAGE 11
                DONE

> PAIRS   _     MESSAGE 17
                SYSMESS 63
                SYSMESS 64
                MESSAGE 18
                MESSAGE 23
                MESSAGE 24
                MESSAGE 21
                DESC    1
                NEWLINE
                DESC    2
                NEWLINE
                MESSAGE 22
                DONE

> EMPTY   _     MESSAGE 19
                MES     25
                MES     26
                MESSAGE 20
                DONE

> TEST    _     MESSAGE 12
                MESSAGE 13
                MESSAGE 14
                MESSAGE 15
                MESSAGE 16
                DONE

;------------------------------------------------------------------------------
/PRO 6

> _       _     WINDOW  1

> _       _     WINAT   0        0
                WINSIZE 10       32
                CLS
                MESSAGE 1
                SET     255

$resetLoop
> _       _     MINUS   255 1
                NOTEQ   255  fGFlags
                CLEAR   @255

> _       _     NOTZERO 255
                SKIP    $resetLoop

> _       _     RESET
                LET     fStrength 50
                LET     fMaxCarr  20
                SET     fCPronounNoun
                SET     fCPronounAdject
                GOTO    1

/END
