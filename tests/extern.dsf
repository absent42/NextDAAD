/MTX
/0 "TICKER MESSAGE FOR GETMSG"
; Messages 1-6: the SVC_GETMSG multi-fetch regression corpus (the
; svc-getmsg HL-clobber defect, found 2026-08-15 in the field). Heavy
; shared phrasing FORCES DRC to token-compress them - the defect only
; fires on token references, which is exactly why the original
; single-message fixture never caught it. xbntest.asm's msg_multi
; (fn 25) fetches all six in one EXTERN and checks each length and
; first two characters against MSGTAB - if these texts change, that
; table changes with them, and the tokenisation byte-check in the
; harness must still hold (raw bytes < decoded length).
/1 "Northern lights over the northern mountains tonight"
/2 "Southern lights over the southern mountains tonight"
/3 "Eastern winds over the eastern mountains this evening"
/4 "Western winds over the western mountains this evening"
/5 "Midnight bells over the midnight mountains ring softly"
/6 "Morning bells over the morning mountains ring softly"
/OTX
/0 "a spare widget"
/LTX
/0 "The XBN test arena."
/CON
/0
/OBJ
;obj  starts  weight    c w  5 4 3 2 1 0 9 8 7 6 5 4 3 2 1 0    noun   adjective
/0    252 1   _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _   _ _
/PRO 0
; ---- main location loop (template shape, no graphics - see
; tests\gmodegate.dsf for the gated version this is trimmed from) ----
> _ _   AT 0                    ; starting the game?
        PROCESS 6
> _ _   WINDOW 1
        WINAT 0 0
        WINSIZE 25 127
        CLS
        DESC @fPlayer
> _ _   PROCESS 1
/PRO 1
; ---- parser loop (template shape, trimmed) ----
; The PROCESS 5 dispatch below is LOAD-BEARING: this fixture was first
; shipped without it (copied from gmodegate.dsf's skeleton, which has no
; command decoder at all - its checks run at boot from PRO 6), so every
; typed verb fell through MOVE to SYSMESS 8 "I can't do that". The X*
; verbs only reach PRO 5 through this entry (test.dsf's template shape).
> _ _   PARSE 0
        REDO
> _ _   PROCESS 5
        ISDONE
        REDO
> _ _   MOVE fPlayer
        CLS
        RESTART
> _ _   NEWTEXT
        LT 33 14
        SYSMESS 7
        REDO
> _ _   SYSMESS 8
        REDO
/PRO 5
; ---- command decoder: one entry per XBN probe verb ----
; The seed goes in FLAG 42 because param1 is 42: HL = flags + param1,
; so the flag the echo reads through HL is the flag numbered by the
; parameter. (The old form seeded flag 150 - a dead write.) The DE leg
; is probed with a second echo at param1 = 0, against object 0, which
; the /OBJ block starts at location 252 (not created) precisely so the
; echo has a value no reset state produces.
> XREG _   LET     42 77     ; seed the flag the HL echo must read back
           EXTERN  42 20     ; echo: A/B=42 C=20 HL=flags+42 DE=objTable+252
           MES     "p "
           PRINT   200       ; expect 42 (param1)
           MES     " fn "
           PRINT   201       ; expect 20 (fn code)
           MES     " hl "
           PRINT   202       ; expect 77 - the seeded flag 42 (HL leg)
           MES     " ix "
           PRINT   204       ; expect 162 ($A2 - IX high)
           MES     "/"
           PRINT   205       ; expect 0 (IX low)
           EXTERN  0 20      ; second echo: DE = objTable + 0*6
           MES     " de "
           PRINT   203       ; expect 252 - object 0's start (DE base)
           LET     42 0      ; RESTORE: flag 42 is FLAG_PROMPT - left
                             ; nonzero it sticks the session prompt in
                             ; fixed mode for every later capture
           DONE
> XCAL _   CALL 37 195         ; COUPLED to tests\xbn\xbntest.asm's call_target
                             ; label, address $C325 (lsb 37, msb 195) - read
                             ; from tests\out\xbn\xbntest.sym after assembly
                             ; (sjasmplus --sym); re-encode here if xbntest.asm
                             ; changes and call_target's address moves. Moved
                             ; from $C306 by Task 9's fn 39 dispatch code and
                             ; window_probe landing ahead of call_target.
           PRINT 220         ; expect 119 ($77)
           CALL 124 229        ; Task 4's owed check: tail_marker, address
                             ; $E57C (lsb 124, msb 229) - the SECOND 8K page
                             ; of the XBN window, proving CALL dispatch
                             ; reaches page 2 and not only page 1. Same
                             ; re-encode caveat as call_target above. Moved
                             ; from $E55D by Task 9's code growth.
           PRINT 222         ; expect 153 ($99)
           DONE
; XSLT - CALL slots. 0, 1, 2 and 3 now reach the toolkit; 4 is still
;        unowned and must remain a safe no-op, which is what this verb
;        pinned before the toolkit existed. Flag 249 MOVES mid-verb (110
;        for slots 0/1, 112 for slot 2, 114 for slot 3) - a dispatch
;        hardcoded to one flag rather than reading 249 cannot follow the
;        move. Safe no-op only on legs staging a pinned-table binary
;        (-XbnAll/-XbnTicker/-XbnFade/-XbnClock/-XbnTool). DO NOT TYPE
;        on the plain -Xbn leg: no table there, so $C00E is fixture code.
> XSLT _   LET     110 42
           LET     111 9           ; non-zero: a byte/pair confusion would show
           LET     248 0
           LET     249 110
           MES     "slot0 "
           CALL    14 192          ; slot 0 = fn 70: flag 110
           MES     " slot1 "
           CALL    17 192          ; slot 1 = fn 71: pair 110/111
           LET     112 9
           LET     113 5
           LET     249 112         ; move the pointer: a hardcoded dispatch
           MES     " slot2 "       ; cannot follow this
           CALL    20 192          ; slot 2 = fn 82: flags 112/113
           MES     " slot3 "
           LET     114 90          ; 90 seconds
           LET     115 0
           LET     249 114
           CALL    23 192          ; slot 3 = fn 83: MM:SS
           MES     " n["
           CALL    26 192          ; slot 4: unowned, must print nothing
           MES     "]"
           DONE
> XCNR _   CLEAR 220
           CALL 0 128        ; $8000 - out of window, must no-op
           PRINT 220         ; expect 0
           DONE
> XTIK _   CLEAR 221
           PAUSE 100         ; one second. DRC HALVES every PAUSE
                             ; operand for the NEXTDAAD target at
                             ; compile time (drb.php getDurationAdjustment:
                             ; baseLength 100 / DEFAULT_NOTE_DURATION 200),
                             ; so this ships as operand 50 = 50 frames.
                             ; An authored PAUSE 50 shipped as 25 and made
                             ; the original "expect ~50" unmeetable - 25
                             ; was the CORRECT reading (silicon-confirmed
                             ; 2026-08-14, 25 ticks in 25 frames = 1:1).
           PRINT 221         ; expect 48-52 (50 +- ISR jitter)
           DONE
> XSVC _   EXTERN 0 21       ; service probe fn - Task 6 fills flags 206+
           PRINT 206         ; expect 2
           PRINT 207
           DONE
> XFIO _   CLEAR 208         ; so a repeat run cannot inherit a stale 1
           EXTERN 0 22        ; fio_probe: write/close/reopen/read/compare
           PRINT 208         ; expect 1 (0 = failed, or no fn 22 handler
                             ; on this leg - see LEG SCOPE above)
           DONE
> XMSG _   EXTERN 0 23        ; msg_probe: SVC_GETMSG on MTX message 0
           PRINT 210         ; expect 84 ('T')
           PRINT 211         ; expect 1
           MES " len "
           PRINT 209         ; expect 25 - the decoded length of
                             ; "TICKER MESSAGE FOR GETMSG"; a truncated
                             ; or over-read decode shows here
           EXTERN 0 24        ; msg_probe_bad: out-of-range message 255
           PRINT 212         ; expect 1 - msg_probe_bad probes message 255,
                             ; out of range (see tests\xbn\xbntest.asm)
           DONE
; XCND - condition semantics: fn 26 returns CF set, which must FAIL the
;        entry (MES "LEAK" unreachable) AND clear the done state, so
;        the following ISNDONE entry holds. THE FIRST ENTRY PINS THE
;        RULED EDGE: a MES runs (stamping done) BEFORE the failing
;        extern, and the clear must win anyway - the documented
;        semantics are "clears the done state", deliberately BLUNTER
;        than a failed built-in condition (which never touches a prior
;        action's stamp). A build without the split path prints LEAK;
;        one that fails the entry but skips the clear falls to the
;        ISDONE entry instead. The second entry's own DONE is LOAD-
;        BEARING, not decoration: without an explicit exit, a
;        CORRECTLY-clearing build falls through to the third entry
;        anyway (MES is an action - it re-stamps done on its own way
;        out), so the ISDONE trap would fire even on a build that got
;        the split path right. DONE stops the table there, so the
;        trap is reached ONLY when ISNDONE itself failed to see the
;        clear (empirically confirmed: without this DONE, "STAMP
;        LEAKED" prints after "notdone ok" even against the correct
;        interpreter).
> XCND _   MES     "pre "
           EXTERN  0 26
           MES     "LEAK"
> XCND _   ISNDONE
           MES     "notdone ok"
           DONE
> XCND _   ISDONE
           MES     "STAMP LEAKED"
; XCNC - control: fn 27 returns CF clear; the entry must complete.
> XCNC _   EXTERN  0 27
           MES     "clear ok"
; XFRM - SVC_FRAMES advances at the frame rate: snapshot, a 50-frame
;        PAUSE, delta must read 48-52 (ISR jitter window, same as XTIK).
;        A stub row or stopped counter cannot land in the window.
> XFRM _   EXTERN  0 28
           PAUSE   100
           EXTERN  0 29
           MES     "frames "
           PRINT   216
           DONE
; XRSK - SVC_RANDOM from the hook while the foreground sits in PAUSE: the
;        sticky changed bit must be 1, and a second arm/disarm cycle
;        must work (no deadlock from the DI bracket). PAUSE 250 ships
;        as 125 frames (DRC halves PAUSE) - 125 hook draws.
> XRSK _   CLEAR   219
           EXTERN  1 35
           PAUSE   250
           EXTERN  0 35
           MES     "alive "
           PRINT   219
           DONE
; XDAT - GETDATE presence probe. SILICON-ONLY: on real NextZXOS the
;        rst $08 M_GETDATE call returns normally, CF reporting RTC
;        presence - expected `rtc 0` or `rtc 1`, never the 9 poison.
;        DO NOT TYPE on ZEsarUX: its esxdos handler does not implement
;        M_GETDATE and the call derails the machine instead of
;        returning (breakpoint-proven on both interpreter variants -
;        PC ends up in ROM error-report territory with a near-zero
;        SP). This verb belongs to the RC silicon run sheet only.
> XDAT _   LET     223 9
           EXTERN  0 36
           MES     "rtc "
           PRINT   223
           DONE
; XBSY - the foreground-invisibility contract itself: every busy source
;        is synchronous with the mainline, so a foreground read is
;        ALWAYS 0. Poisoned first so a dead fn cannot pass. Hook-side
;        visibility of bits 0/2 is silicon/RC territory (video emulator
;        ban); bit 1 hook-capture likewise rides the RC sheet.
> XBSY _   LET     228 9
           EXTERN  0 37
           MES     "busy "
           PRINT   228
           DONE
; XPAL - palette readback: draw picture 1, read all 256 entries back,
;        print the 16-bit checksum. Expected value derived host-side
;        from tools\Rabenstein-master\nextdaad\1.NX2's embedded 512-byte
;        palette plus the interpreter's documented transforms (the $E3
;        collision dodge and the entry-255 stamp, overlay2.asm) - sum
;        1916 ($077C): H=7, L=124. A stub row, a wrong bank or a
;        one-byte-per-entry read cannot reproduce it.
> XPAL _   PICTURE 1
           DISPLAY 0
           EXTERN  0 38
           MES     "pal "
           PRINT   230
           MES     "/"
           PRINT   229
           DONE
; XWIN - window select/restore: DSF sets up window 2, fn 39 selects it,
;        prints W2 there, restores. Expected: "W2" lands in the window-2
;        region (visually distinct row), "back ok" lands in window 1,
;        and the returned-previous flag reads 1 (the main window). A row
;        that ignores A or returns garbage restores to the wrong window
;        and "back ok" lands visibly wrong.
> XWIN _   WINDOW  2
           WINAT   20 0
           WINSIZE 1 40
           WINDOW  1
           EXTERN  2 39
           MES     "back ok prev "
           PRINT   231
           DONE
> XABS _   CLEAR 200
           EXTERN 9 20       ; with NO XBN staged this must stay inert
           PRINT 200         ; expect 0 in the no-XBN leg, 9 with XBN
           DONE
> XTCK _   EXTERN 0 30       ; Task 9 ticker example: arm on message 0
           PAUSE 100         ; ships as operand 50 = ONE second (DRC
                             ; halves PAUSE for this target, see XTIK
                             ; above) - message ticks out in ~0.5s, the
                             ; rest is settle time before the DONE
           EXTERN 0 31       ; disarm (idempotent - int_tick already
                             ; disarms itself once the message is fully
                             ; ticked out)
           DONE
> XFAD _   PICTURE 1         ; only meaningful with -XbnFade staged
           DISPLAY 0         ; (fade example as GAME.XBN + 001.NX2 art);
                             ; without art PICTURE skips DISPLAY, and
                             ; without the fade XBN fn 40 no-ops
           LET 241 0         ; fade speed: default (about one second)
           CLEAR 240         ; completion flag
           EXTERN 224 40     ; fade out to red (%11100000) - a colour,
                             ; not black, so a successful fade cannot be
                             ; mistaken for a blanked screen
           PAUSE 150         ; ships as 75 frames (DRC halves PAUSE) -
                             ; fade is 8 steps x 6 frames + snapshot
           PRINT 240         ; expect 1 (hook set it at completion)
           DONE
> XFDI _   CLEAR 240
           EXTERN 0 41       ; fade back in to the snapshot
           PAUSE 150
           PRINT 240         ; expect 1
           DONE
> XMS6 _   EXTERN 0 25       ; msg_multi: six token-compressed fetches
                             ; in ONE call (the svc-getmsg HL-clobber
                             ; regression - the defect corrupted the
                             ; DDB token table from the first token
                             ; reference of the second fetch)
           PRINT 213         ; expect 6 (messages verified)
           SYSMESS 16        ; "Press any key." - printed AFTER the
                             ; fetches so DDB/token-table health is
                             ; visible on screen: the defect garbled
                             ; exactly this kind of later print
           DONE
> XGFB _   PICTURE 1         ; plain buffered reveal - no fade anywhere
           GFX 0 4           ; graphics to buffer (AFTER the PICTURE
                             ; condition - the ratified ordering)
           DISPLAY 0         ; must NOT appear yet
           PAUSE 100         ; ships as 50 frames - a visible hold in
                             ; which the screen must stay unchanged
           GFX 0 2           ; picture appears NOW, correct colours
           GFX 0 3
           DONE
> XFSC _   PICTURE 1         ; scene change through a fade, NEW sequence
           DISPLAY 0         ; picture 1 up at full brightness
           LET 241 0         ; default fade speed
           CLEAR 240
           EXTERN 224 40     ; fade out to red (%11100000)
           EXTERN 0 43
           PICTURE 2         ; condition - aborts on missing art (screen
                             ; then stays solid red: recover with XFDI)
           GFX 0 4
           DISPLAY 0
           EXTERN 0 42
           GFX 0 2
           GFX 0 3
           CLEAR 240         ; re-arm: 240 is still 1 from the completed
                             ; fade-out, so without this a refused
                             ; fade-in (screen stuck red) false-passes
           EXTERN 0 41
           EXTERN 0 43
           PRINT 240         ; expect 1 - now written by the fade-in
           DONE
> XFSO _   PICTURE 1         ; OLD sequence - regression leg, band and all
           DISPLAY 0
           LET 241 0
           CLEAR 240
           EXTERN 224 40
           EXTERN 0 43
           PICTURE 2
           DISPLAY 0
           EXTERN 0 42
           CLEAR 240         ; same re-arm as XFSC, same false pass
           EXTERN 0 41
           EXTERN 0 43
           PRINT 240
           DONE
> XDRK _   EXTERN 224 40     ; darkness abort: fade out first
           EXTERN 0 43
           PICTURE 99        ; no 099 art staged: condition FAILS, the
           GFX 0 4           ; entry aborts HERE - GFX 0 4 never runs
           DISPLAY 0
> XDRK _   EXTERN 0 41       ; second entry: recover - fade back in
           EXTERN 0 43
           DONE              ; then type XFAD: picture must appear
                             ; (draw target was never set)
> XRST _   GFX 0 4           ; arm buffer mode, then RESTART must clear
           RESTART           ; it - then type XFAD: picture must appear
> XRLD _   RAMSAVE           ; snapshot, arm buffer mode, restore -
           GFX 0 4           ; RAMLOAD must clear the mode - then type
           RAMLOAD 255       ; XFAD: picture must appear
           DONE
> XDCL _   PICTURE 1         ; DISPLAY 1 in both modes (spec 9.7)
           GFX 0 4
           DISPLAY 0         ; deferred
           DISPLAY 1         ; buffer mode: clears the BACK surface (the
                             ; staged pixels) - screen must NOT change
           PAUSE 100
           GFX 0 3           ; mode off; the deferral is still pending
           DISPLAY 1         ; screen mode: clear-flip - transparent
                             ; picture area, NO garbage rows, pending
                             ; reveal discarded
           DONE              ; then XFAD: picture appears normally
> XARM _   GFX 0 4           ; arm buffer mode and stop - the manual
           DONE              ; SAVE/LOAD reset check drives this
; XHNP - preflight. Flag 243 must come back 0 with a hint file staged.
;        Flag 243 is POISONED to 9 first: 0 is also the boot value of
;        every flag, so without the seed a dead fn 52 (absent module,
;        wrong leg, broken dispatch) prints the passing output. With it,
;        0 can only come from the module actually writing the flag.
> XHNP _   LET 243 9
           EXTERN 0 52
           MES "preflight "
           PRINT 243
           DONE
; XHNQ - level count for TOPIC 0, which the sample gives 2 levels. Topic 0
;        deliberately, not 1: MODE_R is 1, so a build that lost the topic
;        parameter would still answer correctly for topic 1 and hide the
;        bug. Every verb below drives topic 0 for the same reason.
> XHNQ _   EXTERN 0 51
           MES "levels "
           PRINT 243
           DONE
; XHNA - automatic mode, three calls. Two DIFFERENT levels then status
;        3 holds only if GAME.HPR's topic 0 is still at level 0 here -
;        run right after XHNR, or on a fresh card.
> XHNA _   LET 242 0
           EXTERN 0 50
           EXTERN 0 50
           EXTERN 0 50
           MES "status "
           PRINT 243
           DONE
; XHNR - clear progress, then one automatic call must print topic 0's FIRST
;        hint again. "reset" prints flag 243 straight after fn 53 - BEFORE
;        fn 50 overwrites it - so a reset that failed to rewrite GAME.HPR
;        (status 5) is visible instead of silently leaving stale progress
;        that the following reprint might mask.
> XHNR _   LET 243 9
           EXTERN 0 53
           MES "reset "
           PRINT 243
           LET 242 0
           EXTERN 0 50
           DONE
; XHNT - topic 1 exists too, with 3 levels. Proves the operand reaches the
;        index rather than only ever selecting one topic.
> XHNT _   EXTERN 1 51
           MES "levels "
           PRINT 243
           DONE
; XCLK - arm and run the clock at 1 in-game minute per real second, from
;        12:00. PAUSE then PRINT: minutes must have advanced. PAUSE 150
;        ships as 75 frames (DRC halves PAUSE for this target) - well past
;        the frame-50 tick boundary, not on it, so the PRINT cannot race it.
> XCLK _   LET     224 12
           LET     225 0
           LET     227 50
           LET     228 0
           EXTERN  0 60
           PAUSE   150
           MES "hh "
           PRINT   224
           MES " mm "
           PRINT   225
           DONE
; XCLA - advance 90 in-game minutes from 12:00: must read 13:30, proving the
;        hour carry.
> XCLA _   LET     224 12
           LET     225 0
           EXTERN  90 62
           MES "hh "
           PRINT   224
           MES " mm "
           PRINT   225
           DONE
; XCLS - stop must freeze the clock. Read minutes, pause, read again: the two
;        must be EQUAL. ORDER-DEPENDENT: type this AFTER XCLK - if the clock
;        was never armed and running, both readings match anyway and this
;        verb passes while proving nothing.
> XCLS _   EXTERN  0 61
           MES "before "
           PRINT   225
           PAUSE   100
           MES " after "
           PRINT   225
           DONE
; XTMR - a 2-second timer must expire. State 3 = expired. PAUSE 250 ships as
;        125 frames (DRC halves PAUSE) - past the 2-second/100-frame
;        expiry, not on it.
> XTMR _   EXTERN  0 63
           LET     229 2
           LET     230 0
           LET     235 1
           PAUSE   250
           MES "state "
           PRINT   235
           MES " rem "
           PRINT   229
           DONE
; XTMI - the cross-module check. The clock is FROZEN here: XCLS stopped it
;        and EXTERN 0 60 below is a documented no-op once armed (it tests
;        its own armed byte, not flag 226), so this verb does not depend
;        on the clock running - it drives the clock itself with fn 62.
;        Slot 1 arms a 2-minute deadline against the clock reset to 12:00
;        (720 + 2 = 722): first state must read 2. Then fn 62 advances the
;        clock 5 minutes (720 + 5 = 725, past the deadline): second state
;        must read 3. A module that only sets state on arming and never
;        reads the clock would print 2 both times.
> XTMI _   LET     224 12
           LET     225 0
           LET     227 50
           LET     228 0
           EXTERN  0 60            ; no-op: already armed (see above)
           EXTERN  0 63
           LET     231 2           ; duration in in-game minutes
           LET     232 0
           EXTERN  1 65            ; slot 1: convert to a deadline (722)
           MES "state "
           PRINT   236
           EXTERN  5 62            ; drive the frozen clock past the deadline (725)
           PAUSE   20
           MES " then "
           PRINT   236
           DONE
; XTLR - a RAMLOAD under a running minute timer, made to prove a REAL
;        restore rather than a vacuous one. Nothing between RAMSAVE and
;        RAMLOAD writes flags 229/230 in the ordinary arm-then-drift path
;        (arm_minutes runs once, before RAMSAVE, and the hook's expiry
;        path writes only the state flag, never the pair) - so on its own
;        the before/after equality would hold whether or not RAMLOAD
;        restores that flag range at all. Clobbering the pair to 0 after
;        the RAMSAVE closes that gap: with the drifted clock at 725 and
;        the pair reading 0, the hook's minutecheck computes deadline-now
;        as a large negative difference (high bit set), falls through to
;        .mexpire and sets state 3 - DURING the pause, before RAMLOAD ever
;        runs. RAMLOAD must then restore BOTH the pair (back to
;        720+90=810 = 3*256+42) and the state (back to 2) for "after" to
;        match "before". Expected output is unchanged from the vacuous
;        version - before 3 42 after 3 42 state 2 - but every one of those
;        five numbers is now genuinely at risk: a restore that left the
;        pair alone would print "after 0 0 state 3" instead.
> XTLR _   LET     224 12
           LET     225 0
           LET     244 0
           LET     227 50
           LET     228 0
           EXTERN  0 60
           EXTERN  0 63
           LET     229 90          ; duration in in-game minutes
           LET     230 0
           EXTERN  0 65            ; convert to a deadline and start counting
           MES "before "
           PRINT   230
           MES " "
           PRINT   229
           RAMSAVE
           LET     225 5           ; drift the live clock under the timer
           LET     229 0           ; clobber the deadline too, so the RAMLOAD below
           LET     230 0           ; has something real to restore
           PAUSE   20
           RAMLOAD 255
           PAUSE   20
           MES " after "
           PRINT   230
           MES " "
           PRINT   229
           MES " state "
           PRINT   235
           DONE
; XCDY - the day counter. Advance 250 in-game minutes from 23:00, which
;        crosses midnight exactly once: day must read 1 and the time 03:10.
> XCDY _   LET     224 23
           LET     225 0
           LET     244 0
           EXTERN  250 62
           MES     "day "
           PRINT   244
           MES     " hh "
           PRINT   224
           MES     " mm "
           PRINT   225
           DONE
; SAVE - SAVE 0 then RESTART; condition-typed, so RESTART only runs on
;        success.
> SAVE _   SAVE    0
           RESTART
; LOAD - LOAD 0 then RESTART, same shape.
> LOAD _   LOAD    0
           RESTART
; XCHK - readback probe: one line, clock + timer state, nothing else.
;        Pairs print high byte first (230/229, 232/231), the order a
;        human reads a 16-bit value in.
> XCHK _   MES     "d "
           PRINT   244
           MES     " t "
           PRINT   224
           MES     ":"
           PRINT   225
           MES     " r "
           PRINT   226
           MES     " s0 "
           PRINT   235
           MES     " p0 "
           PRINT   230
           MES     "/"
           PRINT   229
           MES     " s1 "
           PRINT   236
           MES     " p1 "
           PRINT   232
           MES     "/"
           PRINT   231
           DONE
; XSVT - arms the save-test state; clock left STOPPED so every field but
;        slot 1's real-time pair is exact regardless of tester speed.
;        Rate 250 (5 real sec/in-game minute) so anything that does start
;        it crawls rather than races. PAUSE 4 settles the frame hook
;        before the print. Expect: d 0 t 12:0 r 0 s0 2 p0 3/42 s1 1 p1
;        1/44
> XSVT _   EXTERN  0 60          ; arm the module (no-op if already armed)
           EXTERN  0 61          ; stop it - deadline computed exactly
           LET     227 250       ; rate: 5 real seconds per in-game minute
           LET     228 0
           LET     224 12
           LET     225 0
           LET     244 0
           EXTERN  0 63          ; arm the timer module
           LET     229 90        ; slot 0: 90 in-game minutes
           LET     230 0
           EXTERN  0 65          ; deadline: 720+90=810 = 3*256+42
           LET     231 44        ; slot 1: 300 real seconds, a control
           LET     232 1
           LET     236 1
           PAUSE   4             ; settle: let the frame hook run before print
           MES     "d "
           PRINT   244
           MES     " t "
           PRINT   224
           MES     ":"
           PRINT   225
           MES     " r "
           PRINT   226
           MES     " s0 "
           PRINT   235
           MES     " p0 "
           PRINT   230
           MES     "/"
           PRINT   229
           MES     " s1 "
           PRINT   236
           MES     " p1 "
           PRINT   232
           MES     "/"
           PRINT   231
           DONE
; XSVD - two minutes short of midnight, with a 2-minute duration, so a
;        single XAD1 step lands exactly on the boundary. Clock STOPPED,
;        rate 250. Arithmetic: 23*60+58 = 1438 total, plus 2 = 1440,
;        which is day 1 at 00:00 exactly - deadline high byte 5, low
;        byte 160 (1440 = 5*256+160). Expect:
;        d 0 t 23:58 r 0 s0 2 p0 5/160 s1 1 p1 1/44
> XSVD _   EXTERN  0 60
           EXTERN  0 61
           LET     227 250
           LET     228 0
           LET     224 23
           LET     225 58
           LET     244 0
           EXTERN  0 63
           LET     229 2
           LET     230 0
           EXTERN  0 65          ; deadline: 1438+2=1440 = 5*256+160
           LET     231 44
           LET     232 1
           LET     236 1
           PAUSE   4             ; settle: let the frame hook run before print
           MES     "d "
           PRINT   244
           MES     " t "
           PRINT   224
           MES     ":"
           PRINT   225
           MES     " r "
           PRINT   226
           MES     " s0 "
           PRINT   235
           MES     " p0 "
           PRINT   230
           MES     "/"
           PRINT   229
           MES     " s1 "
           PRINT   236
           MES     " p1 "
           PRINT   232
           MES     "/"
           PRINT   231
           DONE
; XADV - EXTERN 250 62 advances the clock 250 in-game minutes, PAUSE 4,
;        then prints XCHK's line - no real-time wait needed.
> XADV _   EXTERN  250 62
           PAUSE   4             ; settle: let the frame hook run before print
           MES     "d "
           PRINT   244
           MES     " t "
           PRINT   224
           MES     ":"
           PRINT   225
           MES     " r "
           PRINT   226
           MES     " s0 "
           PRINT   235
           MES     " p0 "
           PRINT   230
           MES     "/"
           PRINT   229
           MES     " s1 "
           PRINT   236
           MES     " p1 "
           PRINT   232
           MES     "/"
           PRINT   231
           DONE
; XAD1 - EXTERN 1 62 advances the clock exactly one in-game minute, PAUSE
;        4, then prints XCHK's line - the boundary-stepping verb, for
;        walking onto a deadline one minute at a time.
> XAD1 _   EXTERN  1 62
           PAUSE   4             ; settle: let the frame hook run before print
           MES     "d "
           PRINT   244
           MES     " t "
           PRINT   224
           MES     ":"
           PRINT   225
           MES     " r "
           PRINT   226
           MES     " s0 "
           PRINT   235
           MES     " p0 "
           PRINT   230
           MES     "/"
           PRINT   229
           MES     " s1 "
           PRINT   236
           MES     " p1 "
           PRINT   232
           MES     "/"
           PRINT   231
           DONE
; XRUN - starts the clock running at whatever rate is set (250 after the
;        setup verbs, so 5 real seconds per in-game minute). PAUSE 4,
;        then prints XCHK's line. Exists for one check only: proving the
;        clock still ticks after a load.
> XRUN _   LET     226 1
           PAUSE   4             ; settle: let the frame hook run before print
           MES     "d "
           PRINT   244
           MES     " t "
           PRINT   224
           MES     ":"
           PRINT   225
           MES     " r "
           PRINT   226
           MES     " s0 "
           PRINT   235
           MES     " p0 "
           PRINT   230
           MES     "/"
           PRINT   229
           MES     " s1 "
           PRINT   236
           MES     " p1 "
           PRINT   232
           MES     "/"
           PRINT   231
           DONE
; XSVE - the sharp expiry-boundary setup: XSVT's shape but a 2-minute
;        deadline, so two XAD1 steps walk it across expiry. Clock
;        STOPPED at 12:00, rate 250. Arithmetic: 12*60 = 720, plus 2 =
;        722 - deadline high byte 2, low byte 210 (722 = 2*256+210).
;        Expect: d 0 t 12:0 r 0 s0 2 p0 2/210 s1 1 p1 1/44
> XSVE _   EXTERN  0 60
           EXTERN  0 61
           LET     227 250
           LET     228 0
           LET     224 12
           LET     225 0
           LET     244 0
           EXTERN  0 63
           LET     229 2
           LET     230 0
           EXTERN  0 65          ; deadline: 720+2=722 = 2*256+210
           LET     231 44
           LET     232 1
           LET     236 1
           PAUSE   4             ; settle: let the frame hook run before print
           MES     "d "
           PRINT   244
           MES     " t "
           PRINT   224
           MES     ":"
           PRINT   225
           MES     " r "
           PRINT   226
           MES     " s0 "
           PRINT   235
           MES     " p0 "
           PRINT   230
           MES     "/"
           PRINT   229
           MES     " s1 "
           PRINT   236
           MES     " p1 "
           PRINT   232
           MES     "/"
           PRINT   231
           DONE
; XTMS - fn 64 stops ALL THREE slots: every state clears, every pair is
;        left alone. Arms one real-seconds slot AND one minute-deadline
;        slot first, so the check covers both slot kinds - a stopall
;        that cleared the pairs too, or cleared only one state, or only
;        state-1 slots, prints differently. The pairs are the
;        falsification: slot 0 must still read 300 (1/44) and slot 1
;        must still hold the 810 deadline (3/42) AFTER the stop.
> XTMS _   EXTERN  0 60            ; arm clock (no-op if already armed)
           EXTERN  0 61            ; and stop it - deadline computed exactly
           LET     224 12          ; 12:00, day 0, rate 50
           LET     225 0
           LET     244 0
           LET     227 50
           LET     228 0
           EXTERN  0 63            ; arm the timer module
           LET     229 44          ; slot 0: 300 real seconds = 1*256+44
           LET     230 1
           LET     235 1           ; state 1: counting real seconds
           LET     231 90          ; slot 1: 90-minute duration
           LET     232 0
           EXTERN  1 65            ; slot 1 deadline: 720+90=810 = 3*256+42
           EXTERN  0 64            ; STOP ALL - the condact under test
           PAUSE   4               ; settle: the frame hook must not revive them
           MES     "s0 "
           PRINT   235             ; expect 0
           MES     " s1 "
           PRINT   236             ; expect 0
           MES     " p0 "
           PRINT   230             ; expect 1
           MES     "/"
           PRINT   229             ; expect 44 - pair untouched
           MES     " p1 "
           PRINT   232             ; expect 3
           MES     "/"
           PRINT   231             ; expect 42 - deadline untouched
           DONE
; XHNL - explicit-level mode: flag 242 nonzero pins the level and never
;        touches GAME.HPR. Level 2 is topic 0's LAST level (it has
;        exactly two), so the pair of calls exercises both the in-range
;        print (status 0) and ST_NOLEVEL (3) one past the end. A module
;        that ignored flag 242 and ran automatic mode instead would
;        advance GAME.HPR and could print status 3 on the FIRST call
;        against a used card - the 0/3 pair in this order is the
;        discriminator. Leaves flag 242 back at 0 (automatic).
;        At the bench, type XHNL twice - explicit mode is idempotent,
;        automatic mode is not.
> XHNL _   LET     242 2
           EXTERN  0 50            ; topic 0 level 2: prints the hint
           MES     "status "
           PRINT   243             ; expect 0
           LET     242 3
           EXTERN  0 50            ; topic 0 has no level 3
           MES     " past "
           PRINT   243             ; expect 3 - no such level
           LET     242 0           ; restore automatic mode
           DONE
; XTKP - decimal printing and the width flag. 42 unpadded, then padded to
;        five columns with spaces, then with zeros, then a 16-bit pair.
> XTKP _   LET     100 42
           LET     101 7           ; non-zero: a byte/pair confusion would show
           LET     248 0
           MES     "a["
           EXTERN  100 70
           MES     "] b["
           LET     248 5
           EXTERN  100 70
           MES     "] c["
           LET     248 133
           EXTERN  100 70
           MES     "] d["
           LET     248 0
           LET     100 32
           LET     101 3
           EXTERN  100 71
           MES     "]"
           DONE
; XTKA - 16-bit arithmetic. 1000 + 2000 by pair, then -10 by immediate,
;        then a compare exercising all three outcomes: greater, equal,
;        less.
> XTKA _   LET     100 232         ; 1000 = 3*256 + 232
           LET     101 3
           LET     102 208         ; 2000 = 7*256 + 208
           LET     103 7
           LET     248 0
           LET     249 102
           EXTERN  100 75
           MES     "sum "
           EXTERN  100 71
           LET     249 10
           EXTERN  100 73
           MES     " less "
           EXTERN  100 71
           LET     249 102
           EXTERN  100 74
           MES     " cmp "
           PRINT   251
           MES     " eq "
           LET     100 208         ; 2000, equal to the pair at 102
           LET     101 7
           EXTERN  100 74
           PRINT   251
           MES     " lt "
           LET     100 100         ; 100, less than 2000
           LET     101 0
           EXTERN  100 74
           PRINT   251
           DONE
; XTKO - overflow reporting. 65530 + 10 wraps to 4 and sets flag 251,
;        then a second, non-overflowing add proves flag 251 goes back
;        to 0.
> XTKO _   LET     100 250         ; 65530 = 255*256 + 250
           LET     101 255
           LET     248 0
           LET     249 10
           EXTERN  100 72
           MES     "wrap "
           EXTERN  100 71
           MES     " ovf "
           PRINT   251
           LET     100 10          ; a second add that must NOT overflow
           LET     101 0
           EXTERN  100 72
           MES     " sum "
           EXTERN  100 71
           MES     " ovf "
           PRINT   251
           DONE
; XTKT - both time formats. 09:05 from two byte flags, then two 16-bit
;        second counts as MM:SS - 90 (01:30), then 65 to exercise
;        zero-padding on the seconds digit (01:05), then flag 100/101's
;        HH:MM again under a zero-pad width flag, which the time
;        formats must IGNORE.
> XTKT _   LET     100 9
           LET     101 5
           MES     "t "
           EXTERN  100 82
           LET     102 90
           LET     103 0
           MES     " s "
           EXTERN  102 83
           MES     " s2 "
           LET     104 65
           LET     105 0
           EXTERN  104 83
           LET     248 133         ; zero-pad width 5: the time formats must IGNORE it
           MES     " w "
           EXTERN  100 82
           LET     248 0           ; leave the width flag as we found it
           DONE
; XTKI - arms live values for the status-line pair below: score, clock
;        running 1 in-game minute/real second from 12:00, a 5-minute
;        real-seconds timer.
> XTKI _   LET     100 32          ; score 800 = 3*256 + 32
           LET     101 3
           LET     224 12          ; clock 12:00, day 0
           LET     225 0
           LET     244 0
           LET     227 50          ; 50 frames per in-game minute
           LET     228 0
           EXTERN  0 60            ; arm and start the clock
           EXTERN  0 63            ; arm the timer module
           LET     229 44          ; 300 real seconds = 1*256 + 44
           LET     230 1
           LET     235 1           ; state 1: counting real seconds
           MES     "armed"
           DONE
; XTKS - paints the status line into WINDOW 2 from XTKI's live values,
;        then restores WINDOW 1. Typed by hand, repeated on demand, so it
;        cannot disturb any other verb. WINSIZE 1 40 (not 80) so the bar
;        fits both text modes - the hardware sheet tests both.
> XTKS _   WINDOW  2
           WINAT   16 0
           WINSIZE 1 40
           PAPER   1
           INK     7
           CLS
           MES     "Score "
           LET     248 5
           EXTERN  100 71
           LET     248 0
           MES     "  Time "
           EXTERN  224 82
           MES     "  Fuse "
           EXTERN  229 83
           WINDOW  1
           DONE
/PRO 6
; ---- one-shot init ----
> _ _   WINDOW 1
        WINAT 0 0
        WINSIZE 25 127
        PAPER 0
        INK 7
        CLS
        MES "NEXTDAAD XBN EXTERN FIXTURE#n"
/END
