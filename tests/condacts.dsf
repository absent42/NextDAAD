/MTX
/0 "NEXTDAAD CONDACT SUITE#n"
/OTX
/0 "a brass lamp"
/1 "an old box"
/2 "a gold coin"
/3 "a felt hat"
/LTX
/0 "Suite arena."
/1 ""
/CON
/0
NORTH 0
/1
/OBJ
/0    CARRIED     1   _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _   LAMP _
/1    0           2   Y _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _   BOX  _
/2    NOT_CREATED 1   _ _  _ _ _ _ _ _ _ Y _ _ _ _ _ _ _ _   COIN _
/3    0           1   _ Y  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _   HAT  _
/PRO 0
> _ _   CLS
        MESSAGE 0
        PROCESS 1
> _ _   PARSE 0
/PRO 1
; ---- suite 0: pilot flags ----
> _ _   LET 100 5
        EQ 100 5
        MES "01 OK#n"
        SKIP 1
> _ _   MES "01 F#n"
> _ _   PLUS 100 250
        EQ 100 255
        MES "02 OK#n"
        SKIP 1
> _ _   MES "02 F#n"
> _ _   MINUS 100 255
        ZERO 100
        MES "03 OK#n"
        SKIP 1
> _ _   MES "03 F#n"
> _ _   NOTZERO 37
        MES "04 OK#n"
        SKIP 1
> _ _   MES "04 F#n"
; ---- suite 1: comparisons, indirection, decimal ----
> _ _   LET 101 7
        GT 101 6
        LT 101 8
        NOTEQ 101 9
        MES "05 OK#n"
        SKIP 1
> _ _   MES "05 F#n"
> _ _   LET 102 7
        SAME 101 102
        MES "06 OK#n"
        SKIP 1
> _ _   MES "06 F#n"
> _ _   LET 103 101
        LET @103 42
        EQ 101 42
        MES "07 OK#n"
        SKIP 1
> _ _   MES "07 F#n"
> _ _   SET 104
        EQ 104 255
        CLEAR 104
        ZERO 104
        MES "08 OK#n"
        SKIP 1
> _ _   MES "08 F#n"
> _ _   LET 105 200
        LET 106 100
        ADD 105 106
        EQ 106 255
        BIGGER 106 105
        SMALLER 105 106
        MES "09 OK#n"
        SKIP 1
> _ _   MES "09 F#n"
> _ _   RANDOM 107
        NOTZERO 107
        MES "10 OK#n"
        SKIP 1
> _ _   MES "10 F#n"
> _ _   LET 108 123
        MES "11 PRINT:"
        PRINT 108
        NEWLINE
        MES "11 OK#n"
        SKIP 1
> _ _   MES "11 F#n"
; ---- suite 2: object model ----
> _ _   CARRIED 0
        ISAT 1 0
        ABSENT 2
        MES "12 OK#n"
        SKIP 1
> _ _   MES "12 F#n"
> _ _   CREATE 2
        ISAT 2 255
        PRESENT 2
        MES "13 OK#n"
        SKIP 1
> _ _   MES "13 F#n"
> _ _   SWAP 0 2
        ISAT 0 0
        CARRIED 2
        EQ 1 1
        MES "14 OK#n"
        SKIP 1
> _ _   MES "14 F#n"
> _ _   SETCO 0
        EQ 51 0
        EQ 54 0
        EQ 55 1
        MES "15 OK#n"
        SKIP 1
> _ _   MES "15 F#n"
> _ _   COPYOF 2 110
        EQ 110 254
        LET 111 0
        COPYFO 111 2
        ISAT 2 0
        EQ 1 0
        MES "16 OK#n"
        SKIP 1
> _ _   MES "16 F#n"
> _ _   LET 34 51
        LET 35 255
        WHATO
        EQ 51 0
        MES "17 OK#n"
        SKIP 1
> _ _   MES "17 F#n"
> _ _   DESTROY 2
        ABSENT 2
        MES "18 OK#n"
        SKIP 1
> _ _   MES "18 F#n"
; ---- suite 3: carry mechanics ----
> _ _   ABILITY 2 10
        PLACE 0 0
        PLACE 2 0
        GET 0
        CARRIED 0
        EQ 1 1
        MES "19 OK#n"
        SKIP 1
> _ _   MES "19 F#n"
> _ _   GET 2
        CARRIED 2
        EQ 1 2
        MES "20 OK#n"
        SKIP 1
> _ _   MES "20 F#n"
> _ _   PROCESS 2
        NOTCARR 3
        EQ 1 2
        MES "21 OK#n"
        SKIP 1
> _ _   MES "21 F#n"
> _ _   DROP 0
        ISAT 0 0
        EQ 1 1
        MES "22 OK#n"
        SKIP 1
> _ _   MES "22 F#n"
> _ _   PLACE 3 254
        WEAR 3
        WORN 3
        EQ 1 1
        MES "23 OK#n"
        SKIP 1
> _ _   MES "23 F#n"
> _ _   REMOVE 3
        CARRIED 3
        MES "24 OK#n"
        SKIP 1
> _ _   MES "24 F#n"
> _ _   LET 34 53
        LET 35 255
        AUTOD
        ISAT 3 0
        MES "25 OK#n"
        SKIP 1
> _ _   MES "25 F#n"
> _ _   PUTIN 2 1
        ISAT 2 1
        EQ 1 0        ; the coin was the only carried object
        MES "26 OK#n"
        SKIP 1
> _ _   MES "26 F#n"
> _ _   WEIGH 1 112
        EQ 112 3
        MES "27 OK#n"
        SKIP 1
> _ _   MES "27 F#n"
> _ _   TAKEOUT 2 1
        CARRIED 2
        MES "28 OK#n"
        SKIP 1
> _ _   MES "28 F#n"
> _ _   DROPALL
        ZERO 1
        ISAT 2 0
        MES "29 OK#n"
        SKIP 1
> _ _   MES "29 F#n"
> _ _   RESET
        CARRIED 0
        ISAT 1 0
        ABSENT 2
        EQ 1 1
        MES "30 OK#n"
        SKIP 1
> _ _   MES "30 F#n"
; ---- AUTO-family coverage (IDs A1-A5; keeps 31+ free for suite 4).
> _ _   LET 34 53               ; Noun1 = HAT
        LET 35 255
        AUTOG                   ; hat is here - taken
        CARRIED 3
        EQ 1 2
        MES "A1 OK#n"
        SKIP 1
> _ _   MES "A1 F#n"
> _ _   AUTOW                   ; carried hat - worn
        WORN 3
        EQ 1 1
        MES "A2 OK#n"
        SKIP 1
> _ _   MES "A2 F#n"
> _ _   AUTOR                   ; worn hat - removed to carried
        CARRIED 3
        EQ 1 2
        MES "A3 OK#n"
        SKIP 1
> _ _   MES "A3 F#n"
> _ _   AUTOP 1                 ; carried hat into the box
        ISAT 3 1
        EQ 1 1
        MES "A4 OK#n"
        SKIP 1
> _ _   MES "A4 F#n"
> _ _   AUTOT 1                 ; hat out of the box
        CARRIED 3
        EQ 1 2
        MES "A5 OK#n"
        SKIP 1
> _ _   MES "A5 F#n"
; ---- suite 4: control flow ----
> _ _   PROCESS 3
        ISDONE
        MES "31 OK#n"
        SKIP 1
> _ _   MES "31 F#n"
> _ _   PROCESS 4
        ISNDONE
        MES "32 OK#n"
        SKIP 1
> _ _   MES "32 F#n"
> _ _   SKIP 1
> _ _   MES "33 F#n"
        SKIP 1
> _ _   MES "33 OK#n"
> _ _   PLACE 0 0
        PLACE 1 0
        PLACE 3 0
        LET 113 0
        PROCESS 15
        EQ 113 3
        MES "34 OK#n"
        SKIP 1
> _ _   MES "34 F#n"
; ---- suite 5: printing, lists, windows ----
> _ _   RESET
        SETCO 0
        MES "35:"
        MES "_"
        NEWLINE
        MES "35 OK#n"
        SKIP 1
> _ _   MES "35 F#n"
> _ _   LET 121 0
        MES "36:"
        LISTAT @121
        MES "36 OK#n"
        SKIP 1
> _ _   MES "36 F#n"
> _ _   PAPER 2
        INK 6
        MES "37 COLOUR#n"
        PAPER 0
        INK 7
        MES "37 OK#n"
        SKIP 1
> _ _   MES "37 F#n"
> _ _   SAVEAT
        PRINTAT 20 40
        MES "AT-20-40"
        BACKAT
        NEWLINE
        MES "38 OK#n"
        SKIP 1
> _ _   MES "38 F#n"
; ---- suite 6: movement, synonym, stubs ----
> _ _   LET 33 2
        LET 121 0
        MOVE 121
        EQ 121 0
        MES "39 OK#n"
        SKIP 1
> _ _   MES "39 F#n"
> _ _   LET 33 3
        LET 122 0
        MOVE 122
        MES "40 F#n"
        SKIP 1
> _ _   MES "40 OK#n"
> _ _   SYNONYM GET LAMP        ; GET=verb 100, LAMP=noun 51
        EQ 33 100
        EQ 34 51
        MES "41 OK#n"
        SKIP 1
> _ _   MES "41 F#n"
> _ _   GOTO 0
        AT 0
        MES "42 OK#n"
        SKIP 1
> _ _   MES "42 F#n"
> _ _   BEEP 10 60
        MES "43 OK#n"
        SKIP 1
> _ _   MES "43 F#n"
> _ _   EXTERN 5 3
        MES "44 OK#n"
        SKIP 1
> _ _   MES "44 F#n"
; ---- final-review fix wave (checks 45-50) ----
; 45 REDO: sub-process PRO 16 self-restarts once, guarded by flag 113.
; Pins that REDO stores a coherent entry pointer (finding 1): the entry
; runs exactly twice, so counter 113 ends at 2.
> _ _   LET 113 0
        PROCESS 16
        EQ 113 2
        MES "45 OK#n"
        SKIP 1
> _ _   MES "45 F#n"
; 46 HASAT special values: pins the descending flag map (finding 3).
; WEARABLE 23 -> flag 57 bit 7, CONTAINER 31 -> flag 56 bit 7.
> _ _   SETCO 3                 ; hat: wearable, not container
        HASAT 23
        HASNAT 31
        SETCO 1                 ; box: container, not wearable
        HASAT 31
        HASNAT 23
        MES "46 OK#n"
        SKIP 1
> _ _   MES "46 F#n"
; 47 HASAT extended-attribute byte order: object 2 has attr 0 set in
; /OBJ. Attr 0-7 land in flag 59, 8-15 in flag 58. HASAT 0 true and
; HASNAT 8 true together pin the low/high byte assignment (finding 3).
; NOTE: the 16 /OBJ attribute columns are per-byte MSB-first, i.e.
; attrs 7..0 then 15..8 left to right, so attr 0 is the 8th column
; (verified against DRC output: 8th-column Y compiles to extAttr word
; $0100, whose second byte is flag 59 = attrs 0-7, matching msx2daad).
> _ _   SETCO 2
        HASAT 0
        HASNAT 1
        HASNAT 8
        MES "47 OK#n"
        SKIP 1
> _ _   MES "47 F#n"
; 48 PLACE 255 -> HERE (finding 7): coin placed at 255 must land at the
; player's location (flag 38), not raise error 2.
> _ _   RESET
        GOTO 0
        PLACE 2 255
        COPYOF 2 114
        SAME 114 38
        ISAT 2 0
        MES "48 OK#n"
        SKIP 1
> _ _   MES "48 F#n"
; 49 GET capacity refusal cancels DOALL (finding 5): with MAXCARR 0,
; every GET refuses SM27. DOALL over loc 0 (box + hat) must stop after
; the first refusal, so counter 115 stays at 1 (without the fix it
; iterates every object).
> _ _   RESET
        LET 37 0                ; MAXCARR = 0 -> hands always full
        LET 44 255              ; Noun2/Adj2 clear of any object
        LET 45 255
        LET 115 0
        GOTO 0
        PROCESS 17
        EQ 115 1
        MES "49 OK#n"
        SKIP 1
> _ _   MES "49 F#n"
; 50 QUIT (owner-interactive): SM12 prompt. Press Y -> "50 OK";
; press N (or any non-Y) -> "50 F" then continues. Kept last.
> _ _   QUIT
        MES "50 OK#n"
        SKIP 1
> _ _   MES "50 F#n"
> _ _   MES "SUITES DONE - KEY FOR E03#n"
        ANYKEY
        PROCESS 5
/PRO 2
> _ _   GET 3
/PRO 3
> _ _   DONE
/PRO 4
> _ _   NOTDONE
/PRO 5
> _ _   PROCESS 6
/PRO 6
> _ _   PROCESS 7
/PRO 7
> _ _   PROCESS 8
/PRO 8
> _ _   PROCESS 9
/PRO 9
> _ _   PROCESS 10
/PRO 10
> _ _   PROCESS 11
/PRO 11
> _ _   PROCESS 12
/PRO 12
> _ _   PROCESS 13
/PRO 13
> _ _   PROCESS 14
/PRO 14
> _ _   MES "E03 UNREACHED F#n"
/PRO 15
> _ _   DOALL 0
        PLUS 113 1
/PRO 16
; REDO check (45): restart this table once, guarded by flag 113.
> _ _   PLUS 113 1
        EQ 113 1
        REDO
> _ _   DONE
/PRO 17
; DOALL capacity-cancel check (49): GET each object at loc 0. AUTOG
; refuses SM27 (MAXCARR 0) and cancels the DOALL after object 1.
> _ _   DOALL 0
        PLUS 115 1
        AUTOG
        DONE
/END
