; NextDAAD positioned Layer 2 picture (NX3) fixture.
;
; Staged by tests\build-tests.ps1 -L2Pos (256x192 set, mode 0) or
; -L2PosWide (320x256 set, mode 1) into sd\L2POS\: GAME.DDB, the plain
; pictures 001/008/010 (.NXI or .NX2), the NX3 pictures and NEXTDAAD.NEX. tests\art\mkl2pos.py makes the
; art and, per step, the expected Layer 2 front surface.
;
; One keypress = one step of mkl2pos.py's WALK, in order. Each step
; prints its walk text, runs the walk's condacts verbatim, then "RAN".
; build-tests.ps1 checks every step's condacts against the compiled DDB.
; PICTURE is a condition: a failed load aborts the step entry and the
; next entry for the same step prints "PICTURE FAILED" in red.
;
; Text window 0 = rows 28-31, below every picture region in both modes.
; The ANYKEY wait runs in window 7, a 1x1 window at (0,79): SM16 is a
; space and a space at column 0 prints nothing. No CLS after step 1.

#define fStep               100

/CTL
_
/VOC
NORTH  2  noun
SOUTH  3  noun
LOOK   4  verb
/STX
/0  "It's too dark to see anything."
/1  "I can also see:"
/2  "What now?"
/3  "What next?"
/4  "What should I do now?"
/5  "What should I do next?"
/6  "I didn't understand."
/7  "I can't go in that direction."
/8  "I can't do that."
/9  "I have with me:"
/10 "I am wearing:"
/11 " "
/12 "Are you sure?"
/13 "Another go?"
/14 " "
/15 "OK."
/16 " "
/17 " "
/18 " "
/19 " "
/20 " "
/21 " "
/22 " "
/23 "I'm not wearing one of those."
/24 "I can't. My hands are full."
/25 "I already have the _."
/26 "There isn't one of those here."
/27 "I can't carry any more things."
/28 "I don't have one of those."
/29 "I'm already wearing the _."
/30 "Y"
/31 "N"
/32 "More..."
/33 ">"
/34 " "
/35 " "
/36 "I now have the _."
/37 "I'm now wearing the _."
/38 "I've removed the _."
/39 "I've dropped the _."
/40 "I can't wear the _."
/41 "I can't remove the _."
/42 "I can't remove the _. My hands are full."
/43 "The _ weighs too much for me."
/44 "The _ is in the"
/45 "The _ isn't in the"
/46 ", "
/47 " and "
/48 ".#n"
/49 "I don't have the _."
/50 "I'm not wearing the _."
/51 "."
/52 "There isn't one of those in the"
/53 "Nothing."
/54 " "
/55 " "
/56 " "
/57 "I/O Error"
/58 " "
/59 "File name error."
/60 "Type in name of file."
/MTX
/0 "NEXTDAAD - POSITIONED PICTURES FIXTURE"
/OTX
/0 "a brass lamp"
/LTX
/0 ""
/1 ""
/CON
/0
NORTH 1
/1
SOUTH 0
/OBJ
/0    1   1   _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _   _ _
/PRO 0
; Location 0 = first pass: set up and run step 1. Every later pass
; waits for a key in the parking window and runs the next step.
> _ _   AT 0
        PROCESS 1
        GOTO 1
        DONE
> _ _   WINDOW 7
        ANYKEY
        WINDOW 0
        PROCESS 4
        DONE
/PRO 1
; Windows first, then step 1. MODE 2 = no More... pager.
> _ _   WINDOW 7
        WINAT 0 79
        WINSIZE 1 1
        MODE 2
        WINDOW 0
        WINAT 28 0
        WINSIZE 4 80
        MODE 2
        PAPER 1
        INK 15
        CLS
; step 1: plain LOC1 twice (both surfaces known), TA at 192,160
> _ _   MES "STEP 1 LOC1+TA "
        PICTURE 1
        DISPLAY 0
        PICTURE 1
        DISPLAY 0
        PICTURE 3
        DISPLAY 0
        MES "RAN "
        NEWLINE
        DONE
> _ _   WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        DONE
/PRO 4
; Step ladder: flag 100 = steps run since step 1.
; step 1b: TB at 8,160
> _ _   EQ fStep 0
        MES "STEP 1B TB "
        PICTURE 6
        DISPLAY 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 0
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 2: NX3 LOC2 over rows 0-95, TA and TB kept
> _ _   EQ fStep 1
        MES "STEP 2 LOC2 "
        PICTURE 2
        DISPLAY 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 1
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 2b: HUD rows 96-127
> _ _   EQ fStep 2
        MES "STEP 2B HUD "
        PICTURE 4
        DISPLAY 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 2
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 3: FLT at window 1: mode 0 32,128; mode 1 64,160
> _ _   EQ fStep 3
        MES "STEP 3 WINDOW "
        WINDOW 1
        WINAT 20 16
        WINSIZE 4 16
        PICTURE 5
        DISPLAY 0
        WINDOW 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 3
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 3b: FLT at window 2: mode 0 -32,-32 nothing; mode 1 0,0
> _ _   EQ fStep 4
        MES "STEP 3B ORIGIN "
        WINDOW 2
        WINAT 0 0
        WINSIZE 4 16
        PICTURE 5
        DISPLAY 0
        WINDOW 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 4
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 3c: FLT at window 2: mode 0 -16,-16 (source cols 16-63 rows 16-31 at 0,0, cuts the F); mode 1 16,16
> _ _   EQ fStep 5
        MES "STEP 3C PART CLIP "
        WINDOW 2
        WINAT 2 4
        WINSIZE 4 16
        PICTURE 5
        DISPLAY 0
        WINDOW 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 5
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 4: TB at 160,64 (its notch overwrites LOC2)
> _ _   EQ fStep 6
        MES "STEP 4 OVERRIDE "
        GFX 20 8
        GFX 64 15
        PICTURE 6
        DISPLAY 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 6
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 4b: plain LOC1 at 64,0, right edge clipped
> _ _   EQ fStep 7
        MES "STEP 4B PLAIN AT "
        GFX 8 8
        GFX 0 15
        PICTURE 1
        DISPLAY 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 7
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 4c: X 312: mode 0 nothing; mode 1 8 columns at 312,0
> _ _   EQ fStep 8
        MES "STEP 4C OFF EDGE "
        GFX 39 8
        PICTURE 6
        DISPLAY 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 8
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 4d: cancelled: TB at 8,160 again (no change)
> _ _   EQ fStep 9
        MES "STEP 4D CANCEL "
        GFX 20 8
        GFX 0 27
        PICTURE 6
        DISPLAY 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 9
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 5: TA into the back at 128,128: front unchanged
> _ _   EQ fStep 10
        MES "STEP 5 BUFFER "
        GFX 0 4
        GFX 16 8
        GFX 128 15
        PICTURE 3
        DISPLAY 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 10
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 5a: back copied to front: TA at 128,128
> _ _   EQ fStep 11
        MES "STEP 5A SHOW "
        GFX 0 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
; step 5b: TB into the back at 32,64, swap shows it; screen mode again
> _ _   EQ fStep 12
        MES "STEP 5B SWAP "
        GFX 4 8
        GFX 64 15
        PICTURE 6
        DISPLAY 0
        GFX 0 2
        GFX 0 3
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 12
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 6: both surfaces transparent
> _ _   EQ fStep 13
        MES "STEP 6 CLEAR "
        GFX 0 7
        DISPLAY 1
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
; step 7: other-mode NX3: both cleared, mode switched, TB at 8,160
> _ _   EQ fStep 14
        MES "STEP 7 MODE "
        PICTURE 7
        DISPLAY 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 14
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 8: plain full-surface FULL, back in the set mode
> _ _   EQ fStep 15
        MES "STEP 8 FULL "
        PICTURE 8
        DISPLAY 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 15
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 8a: plain LOC1 after a full picture: clear below row 95
> _ _   EQ fStep 16
        MES "STEP 8A SHORT "
        PICTURE 1
        DISPLAY 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 16
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 8b: front copied to back, then swapped: no visible change
> _ _   EQ fStep 17
        MES "STEP 8B FRONT TO BACK "
        GFX 0 1
        GFX 0 2
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
; step 9: NX3 TALL 100x180 at 40,8
> _ _   EQ fStep 18
        MES "STEP 9 TALL "
        PICTURE 9
        DISPLAY 0
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 18
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 10: DEBUG GFX n 28 reports the pool dry: plain FB1 streamed from the card
> _ _   EQ fStep 19
        MES "STEP 10 FALLBACK "
        GFX 1 28
        PICTURE 10
        GFX 0 28
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 19
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 10a: pool dry: NX3 FB2 streamed to 100,100
> _ _   EQ fStep 20
        MES "STEP 10A FALLBACK POS "
        GFX 1 28
        PICTURE 11
        GFX 0 28
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
> _ _   EQ fStep 20
        WINDOW 0
        INK 10
        MES "PICTURE FAILED "
        NEWLINE
        INK 15
        PLUS fStep 1
        DONE
; step 11: both surfaces transparent
> _ _   EQ fStep 21
        MES "STEP 11 CLEAR "
        GFX 0 7
        DISPLAY 1
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
; step 12: rows 0-7 x 80 columns scrolled 3 times
> _ _   EQ fStep 22
        MES "STEP 12 SCROLL WIDE "
        PROCESS 5
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
; step 12a: rows 10-17, columns 30-49 scrolled 3 times
> _ _   EQ fStep 23
        MES "STEP 12A SCROLL NARROW "
        PROCESS 6
        MES "RAN "
        NEWLINE
        PLUS fStep 1
        DONE
; step 12b: one-row window at row 20
> _ _   EQ fStep 24
        MES "STEP 12B SCROLL ROW "
        PROCESS 7
        MES "RAN "
        MES "END OF WALK "
        NEWLINE
        PLUS fStep 1
        DONE
/PRO 5
; Scroll steps: text windows over rows 0-27, clear of window 0. MODE 2 = no pager.
> _ _   WINDOW 3
        WINAT 0 0
        WINSIZE 8 80
        MODE 2
        MES "SCROLL WIDE LINE A"
        NEWLINE
        MES "SCROLL WIDE LINE B"
        NEWLINE
        MES "SCROLL WIDE LINE C"
        NEWLINE
        MES "SCROLL WIDE LINE D"
        NEWLINE
        MES "SCROLL WIDE LINE E"
        NEWLINE
        MES "SCROLL WIDE LINE F"
        NEWLINE
        MES "SCROLL WIDE LINE G"
        NEWLINE
        MES "SCROLL WIDE LINE H"
        NEWLINE
        MES "SCROLL WIDE LINE I"
        NEWLINE
        MES "SCROLL WIDE LINE J"
        NEWLINE
        MES "SCROLL WIDE LINE K"
        NEWLINE
        WINDOW 0
        DONE
/PRO 6
> _ _   WINDOW 4
        WINAT 10 30
        WINSIZE 8 20
        MODE 2
        MES "NARROW LINE A"
        NEWLINE
        MES "NARROW LINE B"
        NEWLINE
        MES "NARROW LINE C"
        NEWLINE
        MES "NARROW LINE D"
        NEWLINE
        MES "NARROW LINE E"
        NEWLINE
        MES "NARROW LINE F"
        NEWLINE
        MES "NARROW LINE G"
        NEWLINE
        MES "NARROW LINE H"
        NEWLINE
        MES "NARROW LINE I"
        NEWLINE
        MES "NARROW LINE J"
        NEWLINE
        MES "NARROW LINE K"
        NEWLINE
        WINDOW 0
        DONE
/PRO 7
> _ _   WINDOW 5
        WINAT 20 0
        WINSIZE 1 80
        MODE 2
        MES "ROW LINE A"
        NEWLINE
        MES "ROW LINE B"
        NEWLINE
        WINDOW 0
        DONE
/END
