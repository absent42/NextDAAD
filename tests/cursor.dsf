; NextDAAD parser cursor fixture (GFX 22-26). STIMULUS fixture:
; tests\build-tests.ps1 asserts the compiled bytes; tests\cursor_dump.py
; drives it over ZRCP and reads the cursor's tilemap cell after each verb.
; The text window sits on rows 16-31: TRANS draws the palette card on
; rows 0-15 and a hidden prompt would cost extra keys. STORM prints its
; cells with MES (no newline) under MODE 2 (More disabled) so 134 pairs
; land without a pause. Verbs are five characters (DAAD's limit).

/CTL
_
/VOC
GLYPH  50  verb
UPPER  51  verb
BLOCK  52  verb
BLINK  53  verb
FAST   54  verb
STEAD  55  verb
COLOR  56  verb
INKON  57  verb
RESET  58  verb
TRANS  59  verb
UNTRA  60  verb
NARRO  61  verb
WIDE   62  verb
UCASE  63  verb
LCASE  64  verb
AGAIN  65  verb
UNDO   66  verb
W40    67  verb
STORM  68  verb
SAVE   69  verb
LOAD   70  verb
PROBE  71  verb
LOOK   4   verb
/STX
/0  "It's too dark to see anything."
/1  "I can also see:"
/2  "What now?"
/3  "What next?"
/4  "What should I do now?"
/5  "What should I do next?"
/6  "I didn't understand."
/7  "I can't go in that direction."
/8  "I can't do that."
/9  "I have with me:"
/10 "I am wearing:"
/11 " "
/12 "Are you sure?"
/13 "Another go?"
/14 " "
/15 "OK."
/16 "Press any key."
/17 " "
/18 " "
/19 " "
/20 " "
/21 " "
/22 " "
/23 "I'm not wearing one of those."
/24 "I can't. My hands are full."
/25 "I already have the _."
/26 "There isn't one of those here."
/27 "I can't carry any more things."
/28 "I don't have one of those."
/29 "I'm already wearing the _."
/30 "Y"
/31 "N"
/32 "More..."
/33 ">"
/34 " "
/35 " "
/36 "I now have the _."
/37 "I'm now wearing the _."
/38 "I've removed the _."
/39 "I've dropped the _."
/40 "I can't wear the _."
/41 "I can't remove the _."
/42 "I can't remove the _. My hands are full."
/43 "The _ weighs too much for me."
/44 "The _ is in the"
/45 "The _ isn't in the"
/46 ", "
/47 " and "
/48 ".#n"
/49 "I don't have the _."
/50 "I'm not wearing the _."
/51 "."
/52 "There isn't one of those in the"
/53 "Nothing."
/54 " "
/55 " "
/56 " "
/57 "I/O Error"
/58 " "
/59 "File name error."
/60 "Type in name of file."
/MTX
/0  "Cursor arena. Verbs: GLYPH UPPER BLOCK BLINK FAST STEAD COLOR INKON RESET TRANS UNTRA NARRO WIDE UCASE LCASE AGAIN UNDO W40 STORM#n"
/1  "glyph 95#n"
/2  "glyph 223#n"
/3  "block#n"
/4  "blink 25#n"
/5  "blink 3#n"
/6  "steady#n"
/7  "ink 6 paper 0; window white on blue#n"
/8  "ink 2 only; window ink 5#n"
/9  "reset; window white on black#n"
/10 "transparent-paper window over the card#n"
/11 "back to window 0#n"
/12 "one-row input window 2#n"
/13 "input window 0#n"
/14 "upper charset#n"
/15 "lower charset#n"
/16 "again: set all, then RESTART#n"
/17 "undo: RAMSAVE + RAMLOAD 255#n"
/18 "w40: 40 columns and back#n"
/19 "storm done#n"
/20 "X"
/21 "saved#n"
/22 "loaded#n"
/23 "probe#n"
/OTX
/0 "a thing"
/LTX
/0 "Cursor arena."
/CON
/0
/OBJ
/0    0   1   _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _   _ _
/PRO 0
> _ _        ZERO 200
             LET 42 34
             WINDOW 0
             WINAT 16 0
             WINSIZE 16 80
             PAPER 0
             INK 7
             CLS
             MESSAGE 0
             LET 200 1
> _ _        PARSE 0
             REDO
> _ _        PROCESS 1
             REDO
/PRO 1
> GLYPH _    GFX 95 22
             MESSAGE 1
             DONE
> UPPER _    GFX 223 22
             MESSAGE 2
             DONE
> BLOCK _    GFX 0 22
             MESSAGE 3
             DONE
> BLINK _    GFX 25 23
             MESSAGE 4
             DONE
> FAST  _    GFX 3 23
             MESSAGE 5
             DONE
> STEAD _    GFX 0 23
             MESSAGE 6
             DONE
> COLOR _    GFX 6 24
             GFX 0 25
             INK 7
             PAPER 1
             MESSAGE 7
             DONE
> INKON _    GFX 0 26
             GFX 2 24
             INK 5
             MESSAGE 8
             DONE
> RESET _    GFX 0 26
             INK 7
             PAPER 0
             MESSAGE 9
             DONE
> TRANS _    PICTURE 1
             DISPLAY 0
             GFX 1 17
             WINDOW 1
             WINAT 4 8
             WINSIZE 8 64
             PAPER 227
             INK 15
             CLS
             WINDOW 0
             GFX 15 24
             GFX 227 25
             GFX 95 22
             INPUT 1 0
             MESSAGE 10
             DONE
> UNTRA _    GFX 0 17
             INPUT 0 0
             GFX 0 26
             GFX 0 22
             MESSAGE 11
             DONE
> NARRO _    WINDOW 2
             WINAT 30 0
             WINSIZE 1 80
             CLS
             WINDOW 0
             INPUT 2 0
             MESSAGE 12
             DONE
> WIDE  _    INPUT 0 0
             MESSAGE 13
             DONE
> UCASE _    MODE 1
             MESSAGE 14
             DONE
> LCASE _    MODE 0
             MESSAGE 15
             DONE
> AGAIN _    GFX 95 22
             GFX 25 23
             GFX 6 24
             GFX 0 25
             MESSAGE 16
             RESTART
> UNDO  _    RAMSAVE
             RAMLOAD 255
             MESSAGE 17
             DONE
> W40   _    GFX 1 18
             GFX 0 18
             WINAT 16 0
             WINSIZE 16 80
             MESSAGE 18
             DONE
> STORM _    WINDOW 3
             WINAT 15 0
             WINSIZE 1 80
             MODE 2
             LET 100 16
             LET 101 100
             PROCESS 2
             INK 7
             PAPER 0
             CLS
             WINDOW 0
             MESSAGE 19
             DONE
> SAVE  _    SAVE 0
             MESSAGE 21
             DONE
> LOAD  _    LOAD 0
             MESSAGE 22
             DONE
> PROBE _    INK 6
             PAPER 0
             MESSAGE 23
             DONE
> _     _    MESSAGE 0
             DONE
/PRO 2
> _ _        LT 100 150
             INK @100
             PAPER @101
             MES 20
             NEWLINE
             PLUS 100 1
             PLUS 101 1
             REDO
> _ _        DONE
/END
