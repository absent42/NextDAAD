; NextDAAD debugger fixture. build-fixture.ps1 compiles it with -d so the
; DEBUG marker survives, then maps DDB offsets to lines: keep one condact
; per line.
#define fCounter 100
/CTL
_
/VOC
N      2  noun
NORTH  2  noun
S      3  noun
SOUTH  3  noun
GET   20  verb
TAKE  20  verb
DROP  21  verb
OPEN  22  verb
LAMP  50  noun
KEY   51  noun
BRASS  2  adjective
QUICK  2  adverb
IN     2  preposition
/STX
/0  "It's too dark to see anything."
/1  "I can also see:"
/2  "What now?"
/3  "What next?"
/4  "What should I do now?"
/5  "What should I do next?"
/6  "I didn't understand."
/7  "I can't go in that direction."
/8  "I can't do that."
/9  "I have with me:"
/10 "I am wearing:"
/11 " "
/12 "Are you sure?"
/13 "Another go?"
/14 " "
/15 "OK."
/16 "Press any key."
/17 " "
/18 " "
/19 " "
/20 " "
/21 " "
/22 " "
/23 "I'm not wearing one of those."
/24 "I can't. My hands are full."
/25 "I already have the _."
/26 "There isn't one of those here."
/27 "I can't carry any more things."
/28 "I don't have one of those."
/29 "I'm already wearing the _."
/30 "Y"
/31 "N"
/32 "More..."
/33 ">"
/34 " "
/35 " "
/36 "I now have the _."
/37 "I'm now wearing the _."
/38 "I've removed the _."
/39 "I've dropped the _."
/40 "I can't wear the _."
/41 "I can't remove the _."
/42 "I can't remove the _. My hands are full."
/43 "The _ weighs too much for me."
/44 "The _ is in the"
/45 "The _ isn't in the"
/46 ", "
/47 " and "
/48 ".#n"
/49 "I don't have the _."
/50 "I'm not wearing the _."
/51 "."
/52 "There isn't one of those in the"
/53 "Nothing."
/54 " "
/55 " "
/56 " "
/57 "I/O Error"
/58 " "
/59 "File name error."
/60 "Type in name of file."
/MTX
/0 "Hello."
/1 "The lamp glows."
/OTX
/0 "a brass lamp"
/1 "a key"
/LTX
/0 "Hall."
/1 "Cellar."
/CON
/0
SOUTH 1
/1
NORTH 0
/OBJ
/0    0   3   _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _   LAMP BRASS
/1  254   1   _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _   KEY _
/PRO 0
> _ _   LET fCounter 7
        LET @100 3
        DEBUG
        PROCESS 1
> _ _   PARSE 0
        PROCESS 2
        REDO
/PRO 1
> _ _   CLS
        DESC @38
        DONE
/PRO 2
> _ _   MOVE 38
        PROCESS 1
        DONE
> GET LAMP  GET 0
            DONE
> DROP LAMP DROP 0
            DONE
> OPEN KEY  PROCESS 3
> _ _   SYSMESS 8
        DONE
/PRO 3
> _ _   PROCESS 3
/END
