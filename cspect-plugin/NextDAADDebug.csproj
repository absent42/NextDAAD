<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>NextDAADDebug</AssemblyName>
    <RootNamespace>NextDAADDebug</RootNamespace>
    <Version>0.2.2</Version>
    <CSpectDir Condition="'$(CSpectDir)'==''">D:\ZXNextDev\cspect</CSpectDir>
    <Configurations>Debug;Release;Autopilot</Configurations>
  </PropertyGroup>
  <!-- the shipped build carries no PDB path of the build machine -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Autopilot'">
    <DefineConstants>$(DefineConstants);AUTOPILOT</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)'!='Autopilot'">
    <Compile Remove="src\Autopilot\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Plugin">
      <HintPath>$(CSpectDir)\Plugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ImGui.NET">
      <HintPath>$(CSpectDir)\ImGui.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Numerics.Vectors">
      <HintPath>$(CSpectDir)\System.Numerics.Vectors.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NextDAADDebug.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="src\Resources\vga8x16.bin" LogicalName="NextDAADDebug.vga8x16.bin" />
  </ItemGroup>
</Project>
