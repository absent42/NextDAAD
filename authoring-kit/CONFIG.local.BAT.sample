@echo off
REM ---- CONFIG.local.BAT: this machine's settings ----
REM Copy this file to CONFIG.local.BAT. It is read last, so a line here wins
REM over CONFIG.BAT and the game's <GAME>.CFG, and a kit update never
REM replaces it. Put machine settings here (tool folders, RUN) and the game
REM selector: GAME names the game folder to build. Blank auto-detects when
REM exactly one game folder is present. Remove the REM from a line to use it.

REM SET GAME=STARTER
REM SET GAME=MYGAME
REM SET TOOLSDIR=
REM SET RUN=0
